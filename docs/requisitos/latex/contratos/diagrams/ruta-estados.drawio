          <mxGeometry x="24" y="14" width="952" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="La orden estimada con autorización cuenta como COMPLETADA para la ruta. El conteo automático del cierre está pendiente de implementación." style="text;html=1;fontSize=11;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="24" y="44" width="952" height="20" as="geometry"/>
