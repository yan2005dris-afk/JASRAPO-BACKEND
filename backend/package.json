{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=8",
    "npm": ">=999.0.0",
    "yarn": ">=999.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "prisma generate && pnpm run enums:generate",
    "enums:generate": "tsx scripts/generate-enums.ts && prettier --write src/shared/enums/index.ts",
    "prestart": "pnpm run prisma:generate",
    "prestart:dev": "pnpm run prisma:generate",
    "prestart:debug": "pnpm run prisma:generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run build && pnpm test",
    "ci:fix": "pnpm run format:fix && pnpm run lint:fix && pnpm run build && pnpm test",
    "fix:all": "pnpm run format && pnpm run lint:fix && pnpm test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.int-spec.ts test/integration/**/*.int-spec.ts",
    "test:load:pdf": "k6 run test/load/pdf-generation.k6.js",
    "pgboss:dashboard": "export $(grep -v '^#' ../.env | xargs) && PGBOSS_SCHEMA=jobs PORT=3002 npx pg-boss-dashboard"
  },
  "prisma": {
    "seed": "tsx prisma/schema/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1067.0",
    "@aws-sdk/s3-request-presigner": "^3.1067.0",
    "@nestjs-modules/mailer": "2.3.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.16",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "11.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/instrumentation-pg": "^0.70.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.32.0",
    "@peculiar/webcrypto": "^1.5.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.6.0",
    "@signpdf/placeholder-pdfkit010": "npm:@signpdf/placeholder-pdfkit010@^3.3.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "@smithy/node-http-handler": "^4.7.6",
    "@types/nodemailer": "^8.0.0",
    "@xmldom/xmldom": "^0.9.7",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "date-fns": "^4.1.0",
    "date-fns-tz": "3.2.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "ipaddr.js": "^2.4.0",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "prisma": "^7.6.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.1",
    "soap": "^1.9.1",
    "tsx": "^4.21.0",
    "undici": "^8.5.0",
    "xadesjs": "^2.6.5",
    "xml-core": "^1.1.20",
    "xml2js": "^0.6.2",
    "xmldom": "npm:@xmldom/xmldom@^0.9.10"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@pg-boss/dashboard": "^1.2.0",
    "@testcontainers/postgresql": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/node-forge": "^1.3.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/xml2js": "^0.4.14",
    "@types/xmldom": "^0.1.34",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".*\\.integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "moduleNameMapper": {
      "^pg-boss$": "<rootDir>/__mocks__/pg-boss.ts",
      "^puppeteer$": "<rootDir>/__mocks__/puppeteer.ts",
      "^src/(.*)$": "<rootDir>/$1",
      "^(\\..*)\\.js$": "$1"
    },
    "modulePaths": [
      "<rootDir>",
      "node_modules"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "maxWorkers": "50%",
    "workerIdleMemoryLimit": "512MB"
  }
}
