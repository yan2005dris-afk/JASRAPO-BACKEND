# ═══════════════════════════════════════════════════════
# Configuración de JASRAPO Backend
# ═══════════════════════════════════════════════════════
# Copia este archivo como .env y ajusta los valores según
# tu entorno local o de producción.
# ═══════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════
# PostgreSQL — Base de datos principal
# ═══════════════════════════════════════════════════════
# Variables usadas por el contenedor Docker de PostgreSQL
# para inicializar la base de datos, usuario y contraseña.

# Nombre de la base de datos (para Docker)
POSTGRES_DB=appdb
# Usuario de la base de datos (para Docker)
POSTGRES_USER=appuser
# Contraseña del usuario (para Docker)
POSTGRES_PASSWORD=apppass
# Puerto de PostgreSQL (para Docker)
POSTGRES_PORT=5432

# ═══════════════════════════════════════════════════════
# Prisma ORM — Conexión a la base de datos
# ═══════════════════════════════════════════════════════
# DATABASE_URL es la cadena de conexión que Prisma y PgBoss
# usan para conectarse a PostgreSQL. Debe coincidir con las
# credenciales definidas arriba cuando se usa Docker.

# URL de conexión para Prisma (fuera de Docker)
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ═══════════════════════════════════════════════════════
# Entorno y Servidor — Configuración general de la app
# ═══════════════════════════════════════════════════════

# Entorno de ejecución: development | production | test
NODE_ENV=development
# Opt-in operator flag. When `true`, the response body includes the underlying
# error message. Default: false. Never set true in production unless you
# understand the leak (Prisma column names, FK chains, internal IPs).
EXPOSE_ERROR_DETAILS=false
# Puerto donde corre el servidor HTTP
PORT=3000
# Zona horaria del servidor (usada en timestamps)
TZ=America/Guayaquil
# Origen(es) permitidos por CORS (separados por coma, o * para todos)
CORS_ORIGIN=http://localhost:4200

# ═══════════════════════════════════════════════════════
# JWT — Autenticación y tokens
# ═══════════════════════════════════════════════════════
# Claves secretas para firmar tokens JWT de acceso y refresh.
# ACCES_EXPIRES_IN y REFRESH_EXPIRES_IN usan formato de
# duración como "15m", "1h", "7d".

# Secreto para firmar tokens de acceso.
# REQUISITO: >= 32 bytes, alta entropía, NO usar valores por defecto.
# Generá uno con: openssl rand -hex 32
JWT_ACCESS_SECRET=__SET_VIA_OPENSSL_RAND_HEX_32__
# Duración del token de acceso (ej: 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Secreto para firmar tokens de refresh.
# REQUISITO: >= 32 bytes, alta entropía, NO usar valores por defecto.
# Generá uno con: openssl rand -hex 32
JWT_REFRESH_SECRET=__SET_VIA_OPENSSL_RAND_HEX_32__
# Duración del token de refresh (formato ms: 24h, 7d, 30d).
# Por seguridad el default es 24h. Valores > 72h requieren
# ALLOW_LONG_REFRESH=1 o el proceso falla al arrancar.
JWT_REFRESH_EXPIRES_IN=24h
# Opt-in para permitir JWT_REFRESH_EXPIRES_IN > 72h. Úsese solo
# en entornos donde el riesgo de cookie leakage de larga duración
# esté mitigado por otros controles (rotación de cookies, mTLS, etc.).
# ALLOW_LONG_REFRESH=0

# Cost factor de bcrypt para el hash de contraseñas (login/registro).
# OWASP 2024 recomienda >= 12; hashes legados con cost menor se actualizan
# en caliente en el siguiente login válido (re-hash transparente).
# Rango válido: 4..15. Por seguridad NO bajes de 12.
BCRYPT_COST=12

# ═══════════════════════════════════════════════════════
# S3-compatible Storage — Almacenamiento de objetos
# ═══════════════════════════════════════════════════════
# Conexión a un almacenamiento S3-compatible (RustFS, MinIO,
# AWS S3, etc.) para guardar PDFs, XMLs, imágenes, etc.

# Host del servidor S3-compatible
STORAGE_ENDPOINT=localhost
# Puerto del servidor S3-compatible
STORAGE_PORT=9000
# Usar SSL para la conexión (true/false).
# Por seguridad, el valor por defecto es "true".
# En producción (NODE_ENV=production) este valor DEBE ser "true":
# el sistema rechaza arrancar si está en "false" (issue #141, OWASP A02).
STORAGE_USE_SSL=true
# Access key para autenticación S3
STORAGE_ACCESS_KEY=admin
# Secret key para autenticación S3
STORAGE_SECRET_KEY=password123
# Prefijo para los buckets SRI (usado para multi-tenant por RUC)
STORAGE_BUCKET_PREFIX=sri
# Tiempo de expiración de URLs prefirmadas en horas (default: 24)
STORAGE_URL_EXPIRY_HOURS=24

# ═══════════════════════════════════════════════════════
# Límites de Archivos
# ═══════════════════════════════════════════════════════

# Tamaño máximo de subida de archivos en MB (default: 5)
MAX_UPLOAD_SIZE_MB=5

# ═══════════════════════════════════════════════════════
# Logging — Configuración de logs
# ═══════════════════════════════════════════════════════
# Control del logger Pino. LOG_PRETTY formatea los logs
# para desarrollo. LOKI_URL se usa solo en producción.

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info
# Formateo pretty-print para desarrollo (true/false)
LOG_PRETTY=true
# Endpoint de Loki para envío de logs en producción
LOKI_URL=http://localhost:3101

# ═══════════════════════════════════════════════════════
# OpenTelemetry — Trazas y métricas distribuidas
# ═══════════════════════════════════════════════════════
# Configuración de tracing para monitorear el rendimiento
# y rastrear solicitudes entre servicios.

# Habilitar métricas de OpenTelemetry (true/false)
OTEL_METRICS_ENABLED=true
# Endpoint del collector OTLP para exportar trazas
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Nombre del servicio en las trazas
OTEL_SERVICE_NAME=jasrapo-backend
# Ratio de muestreo de trazas (0.0 a 1.0; 0.1 = 10%)
OTEL_TRACE_SAMPLE_RATIO=0.1

# ═══════════════════════════════════════════════════════
# SRI — Integración con el Servicio de Rentas Internas
# ═══════════════════════════════════════════════════════
# Configuración para la facturación electrónica ecuatoriana.
# Incluye conexión al servicio web del SRI, generación de
# PDFs vía Puppeteer, y firmado electrónico de comprobantes.

# URL pública del backend (usada en comprobantes electrónicos)
PUBLIC_URL=http://localhost:3000

# Clave para encriptar datos sensibles (AES-256 = 32 bytes).
# REQUISITO: >= 32 bytes, alta entropía, NO usar valores por defecto.
# Generá una con: openssl rand -hex 32
ENCRYPTION_KEY=__SET_VIA_OPENSSL_RAND_HEX_32__
# Salt para derivación de clave de encriptación
ENCRYPTION_SALT=cambiame_por_un_salt_seguro
# Ambiente del SRI: 1 = Pruebas, 2 = Producción
SRI_AMBIENTE=1
# Emisión asíncrona de comprobantes (true/false)
SRI_EMISION_ASYNC=true
# Máximo de reintentos para envíos al SRI
SRI_MAX_RETRIES=3
# Tiempo de espera entre reintentos al SRI (ms)
SRI_RETRY_DELAY_MS=2000
# Límite máximo de comprobantes a emitir en modo síncrono
SRI_SYNC_MAX_LIMIT=500

# ═══════════════════════════════════════════════════════
# SRI — Cache de Certificados Digitales
# ═══════════════════════════════════════════════════════

# TTL del cache de certificados (.p12) en milisegundos (default: 1 hora)
CACHE_CERT_TTL_MS=3600000

# ═══════════════════════════════════════════════════════
# SRI — Directorios de Almacenamiento Local (Fallback)
# ═══════════════════════════════════════════════════════
# Cuando el almacenamiento S3 no está disponible, el sistema
# usa estos directorios locales como respaldo para XMLs,
# certificados, plantillas y PDFs.

# Directorio para archivos XML
XMLS_DIR=../xmls
# Directorio para certificados digitales (.p12)
CERTS_DIR=../certs
# Directorio para plantillas de documentos
TEMPLATES_DIR=../templates
# Directorio para PDFs generados
PDFS_DIR=../pdfs

# ═══════════════════════════════════════════════════════
# SRI — Configuración de Firma Visual en PDF
# ═══════════════════════════════════════════════════════
# Parámetros para la firma visual que aparece en los PDFs
# de comprobantes electrónicos (tamaño del QR, posición, etc.)

# Tamaño del código QR en la firma (píxeles)
SIGNATURE_QR_SIZE=50
# Ancho total del recuadro de firma (píxeles)
SIGNATURE_TOTAL_WIDTH=200
# Posición X por defecto de la firma
SIGNATURE_DEFAULT_X=0
# Posición Y por defecto de la firma
SIGNATURE_DEFAULT_Y=0
# Página por defecto para la firma (-1 = última página)
SIGNATURE_DEFAULT_PAGE=-1

# ═══════════════════════════════════════════════════════
# Correo Electrónico — Estrategia y Proveedores
# ═══════════════════════════════════════════════════════
# Configuración de envío de correos con soporte multi-proveedor
# (failover/round-robin). Los secrets (usuario y contraseña)
# se mantienen en .env; el resto es configurable desde la
# tabla sistema_config en la base de datos.

# Estrategia de selección de proveedor: failover | round-robin
MAIL_PROVIDER_STRATEGY=failover

# ─── Proveedor primario: Brevo (Sendinblue) ─────────────

# Host SMTP de Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
# Puerto SMTP de Brevo
BREVO_SMTP_PORT=587
# Usuario SMTP de Brevo (API key)
BREVO_SMTP_USER=1@smtp-brevo.com
# Contraseña SMTP de Brevo (API key)
BREVO_SMTP_PASS=tu-api-key-brevo

# ─── Proveedor secundario: Gmail / Hostinger ────────────

# Servicio SMTP
EMAIL_SERVICE=gmail
# Host SMTP de respaldo
EMAIL_HOST=smtp.gmail.com
# Puerto SMTP de respaldo
EMAIL_PORT=587
# Usar SSL en SMTP de respaldo (true/false)
EMAIL_SECURE=false
# Usuario SMTP de respaldo
EMAIL_USER=your-email@gmail.com
# Contraseña SMTP de respaldo
EMAIL_PASSWORD=your-password

# ─── Configuración común de correo ──────────────────────

# Dirección de correo remitente por defecto
EMAIL_FROM=no-reply@jasrapo.com
# Nombre del remitente por defecto
EMAIL_FROM_NAME="JASRAP-Olon"

# ═══════════════════════════════════════════════════════
# Puppeteer — Generación local de PDFs
# ═══════════════════════════════════════════════════════
# Ruta al ejecutable de Chrome/Chromium para Puppeteer.
# Se usa para generar PDFs localmente.
#   Linux:   /usr/bin/google-chrome
#   Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe

PUPPETEER_EXECUTABLE_PATH=
