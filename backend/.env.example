# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=1m
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
# DATABASE_URL para uso local (Prisma fuera de Docker)
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ─── S3-compatible Storage (RustFS) ────────────
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=password123
# Bucket prefix for SRI storage (used for multi-tenant per RUC)
STORAGE_BUCKET_PREFIX=sri
# Presigned URL expiry in hours (default: 24)
STORAGE_URL_EXPIRY_HOURS=24
# Límite de carga de imágenes (MB)
MAX_UPLOAD_SIZE_MB=5

# ─── Observability ─────────────────────────────
# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# OpenTelemetry Tracing
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=jasrapo-backend
OTEL_TRACE_SAMPLE_RATIO=0.1

# Loki (solo envío activo en producción)
LOKI_URL=http://localhost:3101

# ─── SRI Integration ───────────────────────────
PUBLIC_URL=http://localhost:3000
CARBONE_API=http://carbone:8080
ENCRYPTION_KEY=cambiame_por_una_llave_segura_de_32_chars
ENCRYPTION_SALT=cambiame_por_un_salt_seguro
# Ambientes SRI (1: Pruebas, 2: Producción)
SRI_AMBIENTE=1

# Directorios de Almacenamiento Local (Fallback)
XMLS_DIR=../xmls
CERTS_DIR=../certs
TEMPLATES_DIR=../templates
PDFS_DIR=../pdfs

# Configuración de firma visual PDF (SRI)
SIGNATURE_QR_SIZE=50
SIGNATURE_TOTAL_WIDTH=200
SIGNATURE_DEFAULT_X=0
SIGNATURE_DEFAULT_Y=0
SIGNATURE_DEFAULT_PAGE=-1

# ─── Mail ──────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-password
EMAIL_FROM=no-reply@jasrapo.com
EMAIL_FROM_NAME="JASRAP-Olon"
