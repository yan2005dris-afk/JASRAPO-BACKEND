# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=1m
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
# DATABASE_URL para uso local (Prisma fuera de Docker)
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ─── MinIO ─────────────────────────────────────
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
# Bucket prefix for SRI storage (used for multi-tenant per RUC)
MINIO_BUCKET_PREFIX=sri
# Presigned URL expiry in hours (default: 24)
MINIO_URL_EXPIRY_HOURS=24

# ─── Observability ─────────────────────────────
# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# OpenTelemetry Tracing
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=jasrapo-backend
OTEL_TRACE_SAMPLE_RATIO=0.1

# Loki (solo envío activo en producción)
LOKI_URL=http://localhost:3101

# ─── SRI Integration ───────────────────────────
PUBLIC_URL=http://localhost:3000
CARBONE_API=http://carbone:8080
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password_para_redis
ENCRYPTION_KEY=cambiame_por_una_llave_segura_de_32_chars
# Ambientes SRI (1: Pruebas, 2: Producción)
SRI_AMBIENTE=1

# ─── Mail ──────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-password
EMAIL_FROM=no-reply@jasrapo.com
EMAIL_FROM_NAME="JASRAP-Olon"
