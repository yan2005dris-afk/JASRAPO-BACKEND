{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [".dto.ts", ".entity.ts"]
        }
      }
    ],
    "deleteOutDir": true,
    "assets": [
      "metadata.json",
      { "include": "infrastructure/pdf/templates/**/*.hbs", "outDir": "dist/src" },
      { "include": "infrastructure/mail/templates/**/*.hbs", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}