<!DOCTYPE html>
<html lang="es">
<head>
  {% render "styles" %}
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recaudación y Morosidad</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: #333;
            background-color: #fff;
            display: flex;
            justify-content: center;
            padding: 20px;
            margin: 0;
        }

        @page {
            margin: 0;
            size: A4 portrait;
        }

        .report-container {
            background-color: #fff;
            width: 100%;
            padding: 40px;
            box-sizing: border-box;
        }

        .header-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
        }

        .title { font-size: 14px; font-weight: normal; }

        .subtitle {
            text-align: center;
            font-size: 14px;
            font-weight: normal;
            margin: 10px 0 4px;
        }

        .meta-line {
            text-align: center;
            font-size: 12px;
            margin-bottom: 15px;
        }

        .meta-line span { margin: 0 14px; }

        .report-type { text-align: right; font-size: 12px; margin-bottom: 5px; }

        table { width: 100%; border-collapse: collapse; font-size: 12px; }

        thead th {
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
            padding: 4px 2px;
            font-weight: normal;
            text-align: left;
        }

        td { padding: 3px 2px; vertical-align: top; }

        .text-right { text-align: right; }
        .text-center { text-align: center; }

        .total-row td {
            border-top: 1px solid #000;
            padding-top: 6px;
            font-weight: bold;
        }
    </style>
</head>
<body>

<div class="report-container">

    <div class="header-row">
        <div style="width: 100px;"></div>
        <div class="title">{{institucion.nombreLegal}}</div>
        <div></div>
    </div>

    <div class="subtitle">{{titulo}}</div>

    <div class="meta-line">
        <span>Fecha de corte: {{meta.fechaCorte}}</span>
        <span>Filtro: {{filtros.descripcion}}</span>
        <span>Cuentas en mora: {{kpis.totalMorosos}}</span>
        <span>Mayor deuda: ${{kpis.mayorDeuda}}</span>
    </div>

    <div class="report-type">
        DETALLADO · Versión {{institucion.version}}
    </div>

    <table>
        <thead>
            <tr>
                <th>N° GUIA</th>
                <th>CLIENTE</th>
                <th>IDENTIFICACION</th>
                <th>SECTOR</th>
                <th class="text-center">MESES MORA</th>
                <th class="text-center">ULT. EMISION</th>
                <th class="text-right">DEUDA TOTAL</th>
            </tr>
        </thead>
        <tbody>
            {% for item in data %}
            <tr>
                <td>{{ item.numeroGuia }}</td>
                <td>{{ item.clienteNombre }}</td>
                <td>{{ item.identificacion }}</td>
                <td>{{ item.sectorNombre }}</td>
                <td class="text-center">{{ item.mesesLabel }}</td>
                <td class="text-center">{{ item.ultimaEmision }}</td>
                <td class="text-right">${{ item.saldoPendiente }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="7" class="text-center">
                    No se registraron cuentas en mora para el contexto seleccionado.
                </td>
            </tr>
            {% endfor %}
            <tr class="total-row">
                <td colspan="6" class="text-right">TOTAL MOROSIDAD:</td>
                <td class="text-right">${{kpis.totalMorosidad}}</td>
            </tr>
        </tbody>
    </table>

</div>

</body>
</html>
