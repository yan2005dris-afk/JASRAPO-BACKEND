<!DOCTYPE html>
<html lang="es">
<head>
  {{> styles}}
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #333; }
    .container { width: 100%; padding: 20px; }

    .header { border-bottom: 2px solid var(--primary-color); padding-bottom: 12px; margin-bottom: 16px; }
    .header table { width: 100%; border-collapse: collapse; }
    .header td { border: none; vertical-align: middle; padding: 0; }
    .header td.right { text-align: right; }
    .company-name { font-size: 16px; font-weight: bold; color: var(--primary-color); }
    .company-sub { font-size: 10px; color: #666; }
    .report-title { font-size: 18px; font-weight: bold; color: var(--primary-color); }
    .report-meta { font-size: 10px; color: #666; margin-top: 4px; }

    .summary { margin-bottom: 14px; }
    .badge { display: inline-block; background: var(--primary-color); color: white; padding: 4px 12px; font-size: 11px; font-weight: bold; }

    table.data { width: 100%; border-collapse: collapse; margin-top: 8px; }
    table.data th {
      background-color: var(--primary-color);
      color: white;
      padding: 7px 8px;
      text-align: left;
      font-size: 10px;
      font-weight: bold;
    }
    table.data td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; font-size: 10px; vertical-align: top; }
    table.data tr.even td { background-color: var(--primary-color-light); }
    table.data tr.subtotal td {
      background-color: #e8f0fe;
      font-weight: bold;
      font-size: 10px;
      border-top: 1px solid var(--primary-color);
    }
    table.data tr.grand-total td {
      background-color: var(--primary-color);
      color: white;
      font-weight: bold;
      font-size: 11px;
    }
    .num { text-align: right; }

    .footer { margin-top: 24px; text-align: center; font-size: 9px; color: #aaa; border-top: 1px solid #ddd; padding-top: 8px; }
  </style>
</head>
<body>
  <div class="container">

    <!-- Header -->
    <div class="header">
      <table>
        <tr>
          <td>
            <div class="company-name">JASRAPO</div>
            <div class="company-sub">Junta de Agua Potable y Alcantarillado</div>
            <div class="company-sub">Olón - Santa Elena</div>
          </td>
          <td class="right">
            <div class="report-title">{{reporte.titulo}}</div>
            <div class="report-meta">Fecha de emisión: {{reporte.fechaEmision}}</div>
            <div class="report-meta">Período: {{reporte.rangoFechas}}</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Resumen -->
    <div class="summary">
      <span class="badge">Total registros: {{reporte.totalRegistros}}</span>
      <span style="margin-left:16px; font-weight:bold; color:var(--primary-color);">TOTAL GENERAL: $ {{reporte.totalGeneral}}</span>
    </div>

    <!-- Tabla -->
    <table class="data">
      <thead>
        <tr>
          <th>#</th>
          <th>FACTURA</th>
          <th>FECHA</th>
          <th>CLIENTE</th>
          <th>CUENTA</th>
          <th>MEDIDOR</th>
          <th>EMISIÓN</th>
          <th class="num">VALOR</th>
        </tr>
      </thead>
      <tbody>
        {{#each reporte.filas}}
          {{#if this.isData}}
          <tr class="{{#if @even}}even{{/if}}">
            <td>{{this.displayIndex}}</td>
            <td>{{this.factura}}</td>
            <td>{{this.fecha}}</td>
            <td>{{this.clienteNombre}}</td>
            <td>{{this.cuenta}}</td>
            <td>{{this.medidor}}</td>
            <td>{{this.emision}}</td>
            <td class="num">$ {{this.valor}}</td>
          </tr>
          {{/if}}
          {{#if this.isSubtotal}}
          <tr class="subtotal">
            <td colspan="7" style="text-align:right; padding-right:12px;">TOTAL FACTURA {{this.factura}}:</td>
            <td class="num">$ {{this.subtotalValor}}</td>
          </tr>
          {{/if}}
        {{/each}}
        <tr class="grand-total">
          <td colspan="7" style="text-align:right; padding-right:12px;">TOTAL GENERAL:</td>
          <td class="num">$ {{reporte.totalGeneral}}</td>
        </tr>
      </tbody>
    </table>

    <!-- Footer -->
    <div class="footer">
      <p>Reporte generado por el sistema JASRAPO. Documento de uso interno.</p>
    </div>

  </div>
</body>
</html>
