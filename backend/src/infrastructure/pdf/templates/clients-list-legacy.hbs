<!DOCTYPE html>
<html lang="es">
<head>
  {{> styles}}
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #333; }
    .container { width: 100%; padding: 20px; }

    .header { border-bottom: 2px solid var(--primary-color); padding-bottom: 12px; margin-bottom: 16px; }
    .header table { width: 100%; border-collapse: collapse; }
    .header td { border: none; vertical-align: middle; padding: 0; }
    .header td.right { text-align: right; }
    .company-name { font-size: 16px; font-weight: bold; color: var(--primary-color); }
    .company-sub { font-size: 10px; color: #666; }
    .report-title { font-size: 18px; font-weight: bold; color: var(--primary-color); }
    .report-meta { font-size: 10px; color: #666; margin-top: 4px; }

    .summary { margin-bottom: 14px; }
    .badge { display: inline-block; background: var(--primary-color); color: white; padding: 4px 12px; font-size: 11px; font-weight: bold; }

    table.clients { width: 100%; border-collapse: collapse; margin-top: 8px; }
    table.clients th {
      background-color: var(--primary-color);
      color: white;
      padding: 7px 8px;
      text-align: left;
      font-size: 10px;
      font-weight: bold;
    }
    table.clients td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; font-size: 10px; vertical-align: top; }
    table.clients tr.even td { background-color: var(--primary-color-light); }
    table.clients .estado-activo { color: #1a7a2e; font-weight: bold; }
    table.clients .estado-inactivo { color: #c0392b; font-weight: bold; }

    .footer { margin-top: 24px; text-align: center; font-size: 9px; color: #aaa; border-top: 1px solid #ddd; padding-top: 8px; }
  </style>
</head>
<body>
  <div class="container">

    <!-- Header -->
    <div class="header">
      <table>
        <tr>
          <td>
            <div class="company-name">{{institucion.siglas}}</div>
            <div class="company-sub">{{institucion.nombreLegal}}</div>
            <div class="company-sub">{{institucion.ubicacion.localidad}} - {{institucion.ubicacion.provincia}}</div>
          </td>
          <td class="right">
            <div class="report-title">{{reporte.titulo}}</div>
            <div class="report-meta">Fecha de emisión: {{reporte.fecha}}</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Resumen -->
    <div class="summary">
      <span class="badge">Total de clientes: {{reporte.totalClientes}}</span>
      {{#if reporte.filtrosAplicados}}
      <span style="margin-left:12px; font-size:10px; color:#666;">Filtros: {{reporte.filtrosAplicados}}</span>
      {{/if}}
    </div>

    <!-- Tabla de clientes -->
    <table class="clients">
      <thead>
        <tr>
          <th>#</th>
          <th>Identificación</th>
          <th>Tipo</th>
          <th>Nombre / Razón Social</th>
          <th>Email</th>
          <th>Teléfono</th>
          <th>Dirección</th>
          <th>Estado</th>
        </tr>
      </thead>
      <tbody>
        {{#each reporte.clientes}}
        <tr class="{{#if @even}}even{{/if}}">
          <td>{{math @index '+' 1}}</td>
          <td>{{this.identificacion}}</td>
          <td>{{this.tipoId}}</td>
          <td>{{this.nombre}}</td>
          <td>{{this.email}}</td>
          <td>{{this.telefono}}</td>
          <td>{{this.direccion}}</td>
          <td class="{{#if (eq this.activo 'Activo')}}estado-activo{{else}}estado-inactivo{{/if}}">
            {{this.activo}}
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Footer -->
    <div class="footer">
      <p>Reporte generado por el sistema {{institucion.siglas}}. Documento de uso interno.</p>
    </div>

  </div>
</body>
</html>
