<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Prefactura - {{institucion.siglas}}</title>
  {{> styles}}
  {{> modern-styles}}
  <style>
    .invoice-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 16px;
    }

    .info-card {
      background-color: var(--brand-light);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 10px 14px;
    }

    .info-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 4px;
      font-size: 9px;
    }

    .info-row:last-child {
      margin-bottom: 0;
    }

    .info-label {
      color: var(--text-muted);
      font-weight: 600;
    }

    .info-val {
      color: var(--brand-dark);
      font-weight: 700;
    }

    .totals-box {
      width: 280px;
      margin-left: auto;
      margin-top: 14px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      overflow: hidden;
    }

    .totals-row {
      display: flex;
      justify-content: space-between;
      padding: 5px 10px;
      font-size: 9px;
      border-bottom: 1px solid #f1f5f9;
      color: var(--text-main);
    }

    .totals-row:last-child {
      border-bottom: none;
    }

    .totals-row.grand-total {
      background-color: #fef2f2;
      border-top: 2px solid #fecaca;
      font-weight: 800;
      font-size: 11px;
      color: #dc2626;
      padding: 8px 10px;
    }

    .period-badge {
      display: inline-block;
      background: var(--brand-main);
      color: #ffffff;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.5px;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <div class="page-container">

    <!-- Header -->
    <div class="header-table">
      <div class="header-left">
        <div class="logo-container">
          <img src="{{institucion.branding.logo.url}}" alt="Logo institucional" />
        </div>
        <div>
          <div class="brand-title">{{institucion.siglas}}</div>
          <div class="brand-subtitle">{{institucion.nombreLegal}} · {{institucion.ubicacion.localidad}}</div>
          <div class="report-title-main" style="margin-top: 6px;">Prefactura de Servicio de Agua</div>
          <div class="report-meta-text">Fecha de emisión: {{prefactura.createdAt}}</div>
        </div>
      </div>

      <div class="header-right">
        <div class="total-label-sm">PREFACTURA N°</div>
        <div class="total-amount-lg" style="color: var(--brand-main); font-size: 18px;">
          PRE-{{prefactura.prefacturaId}}
        </div>
        <div class="period-badge">Período {{prefactura.periodo.nombre}}</div>
      </div>
    </div>

    <!-- Info Cards Grid -->
    <div class="invoice-grid">
      <div class="info-card">
        <div class="info-row">
          <span class="info-label">Cliente / Titular:</span>
          <span class="info-val">{{prefactura.clienteNombre}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Cédula / RUC:</span>
          <span class="info-val">{{prefactura.clienteIdentificacion}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Dirección:</span>
          <span class="info-val">{{prefactura.clienteDireccion}}</span>
        </div>
      </div>

      <div class="info-card">
        <div class="info-row">
          <span class="info-label">N° de Guía / Contrato:</span>
          <span class="info-val">{{prefactura.contrato.numeroGuia}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Email de Notificación:</span>
          <span class="info-val">{{prefactura.clienteEmail}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Fecha de Vencimiento:</span>
          <span class="info-val" style="color: #dc2626;">{{prefactura.periodo.fechaVencimiento}}</span>
        </div>
      </div>
    </div>

    <!-- Charges Table -->
    <table class="modern-table">
      <thead>
        <tr>
          <th>Descripción</th>
          <th style="text-align: center;">Cantidad</th>
          <th style="text-align: right;">Precio Unit.</th>
          <th style="text-align: right;">Subtotal</th>
          <th style="text-align: right;">IVA</th>
          <th style="text-align: right; font-weight: 700;">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each prefactura.detalles}}
        <tr>
          <td style="font-weight: 600; color: var(--brand-dark);">{{this.descripcion}}</td>
          <td style="text-align: center;">{{this.cantidad}}</td>
          <td style="text-align: right;">${{this.precioUnitario}}</td>
          <td style="text-align: right;">${{this.subtotal}}</td>
          <td style="text-align: right;">${{this.iva}}</td>
          <td style="text-align: right; font-weight: 700;">${{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Totals Summary -->
    <div class="totals-box">
      <div class="totals-row">
        <span>Subtotal:</span>
        <span style="font-weight: 600;">${{prefactura.subtotal}}</span>
      </div>
      <div class="totals-row">
        <span>IVA:</span>
        <span>${{prefactura.iva}}</span>
      </div>
      {{#if prefactura.descuentoTotal}}
      <div class="totals-row">
        <span>Descuento:</span>
        <span style="color: #16a34a;">-${{prefactura.descuentoTotal}}</span>
      </div>
      {{/if}}
      {{#if prefactura.interesMora}}
      <div class="totals-row">
        <span>Interés por Mora:</span>
        <span style="color: #dc2626;">+${{prefactura.interesMora}}</span>
      </div>
      {{/if}}
      {{#if prefactura.deudaAnterior}}
      <div class="totals-row">
        <span>Deuda Anterior:</span>
        <span style="color: #dc2626;">+${{prefactura.deudaAnterior}}</span>
      </div>
      {{/if}}
      <div class="totals-row grand-total">
        <span>TOTAL A PAGAR:</span>
        <span>${{prefactura.totalPagar}}</span>
      </div>
    </div>

    <!-- Footer Note -->
    <div class="footer-note" style="margin-top: 24px;">
      Este documento es una prefactura informativa para el abonado. El comprobante electrónico SRI oficial se emite al completar el pago en ventanillas autorizadas.
    </div>

  </div>
</body>
</html>
