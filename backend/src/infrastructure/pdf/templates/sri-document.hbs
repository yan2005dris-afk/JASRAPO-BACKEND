<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      font-size: 11pt;
      line-height: 1.5;
      color: #333;
      padding: 20mm 15mm;
    }
    h1 {
      font-size: 16pt;
      color: #1a5276;
      border-bottom: 2px solid #1a5276;
      padding-bottom: 8px;
      margin-bottom: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    th, td {
      border: 1px solid #ccc;
      padding: 6px 10px;
      text-align: left;
      vertical-align: top;
    }
    th {
      background-color: #f0f4f8;
      font-weight: 600;
      width: 30%;
    }
    td {
      width: 70%;
    }
    .footer {
      margin-top: 30px;
      font-size: 9pt;
      color: #888;
      text-align: center;
      border-top: 1px solid #ddd;
      padding-top: 10px;
    }
    .badge {
      display: inline-block;
      background: #1a5276;
      color: white;
      padding: 2px 10px;
      border-radius: 3px;
      font-size: 9pt;
    }
  </style>
</head>
<body>
  <h1>{{title}}</h1>
  <p><span class="badge">Generado: {{generatedAt}}</span></p>

  <table>
    {{#each data}}
      <tr>
        <th>{{@key}}</th>
        <td>
          {{#if (isObject this)}}
            <pre>{{json this}}</pre>
          {{else if (isArray this)}}
            {{#if (isPrimitiveArray this)}}
              <ul>
                {{#each this}}
                  <li>{{this}}</li>
                {{/each}}
              </ul>
            {{else}}
              <table>
                {{#each this}}
                  <tr>
                    {{#each this}}
                      <td>{{this}}</td>
                    {{/each}}
                  </tr>
                {{/each}}
              </table>
            {{/if}}
          {{else}}
            {{this}}
          {{/if}}
        </td>
      </tr>
    {{/each}}
  </table>

  <div class="footer">
    Documento generado electrónicamente - {{generatedAt}}
  </div>
</body>
</html>
