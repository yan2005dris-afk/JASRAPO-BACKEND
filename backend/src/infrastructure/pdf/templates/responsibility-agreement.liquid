<!DOCTYPE html>
<html lang="es">
<head>
  {% render "styles" %}
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 12px; color: #333; position: relative; }
    .container { width: 100%; padding: 30px 40px; position: relative; z-index: 1; }

    .watermark {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      opacity: 0.15;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .watermark img {
      width: 60%;
      max-height: 60%;
      object-fit: contain;
    }

    .header { width: 100%; border-bottom: 2px solid var(--primary-color); padding-bottom: 15px; margin-bottom: 25px; }
    .header table { width: 100%; border-collapse: collapse; }
    .header td { vertical-align: middle; padding: 0; border: none; }
    .header-logo { width: 70px; vertical-align: middle; padding-right: 15px; }
    .header-logo img { max-width: 60px; max-height: 60px; object-fit: contain; }
    .company-name { font-size: 20px; font-weight: bold; color: var(--primary-color); }
    .company-sub { font-size: 11px; color: #666; margin-top: 2px; }

    .title-section { text-align: center; margin-bottom: 25px; }
    .title-section h1 { font-size: 16px; font-weight: bold; color: var(--primary-color); text-transform: uppercase; letter-spacing: 1px; }

    .body-text { font-size: 12px; line-height: 1.8; text-align: justify; margin-bottom: 14px; }

    .clause-list { margin: 16px 0; padding-left: 0; list-style: none; }
    .clause-list li { margin-bottom: 12px; font-size: 12px; line-height: 1.8; text-align: justify; padding-left: 25px; position: relative; }
    .clause-list li .clause-num { position: absolute; left: 0; font-weight: bold; }

    .closing-text { font-size: 12px; line-height: 1.8; text-align: justify; margin: 20px 0; }

    .signature-section { margin-top: 50px; text-align: center; }
    .sig-line { border-bottom: 1px dotted #333; width: 60%; margin: 0 auto 8px; height: 35px; }
    .sig-label { font-size: 11px; color: #555; margin-bottom: 2px; }
    .sig-name { font-weight: bold; font-size: 12px; }
    .sig-ci { font-size: 11px; color: #555; }
    .sig-role { font-size: 11px; color: #555; font-style: italic; margin-top: 2px; }

    .footer { margin-top: 40px; text-align: center; font-size: 10px; color: #999; border-top: 1px solid #ddd; padding-top: 10px; }
  </style>
</head>
<body>
  {% if institucion.branding.marcaAgua.url %}
  <div class="watermark">
    <img src="{{institucion.branding.marcaAgua.url}}" alt="Marca de agua institucional">
  </div>
  {% endif %}
  <div class="container">

    <!-- Header -->
    <div class="header">
      <table>
        <tr>
          {% if institucion.branding.logo.url %}
          <td class="header-logo">
            <img src="{{institucion.branding.logo.url}}" alt="Logo">
          </td>
          {% endif %}
          <td>
            <div class="company-name">{{institucion.siglas}}</div>
            <div class="company-sub">{{institucion.nombreLegal}}</div>
            <div class="company-sub">RUC: {{institucion.ruc}} &nbsp;|&nbsp; {{institucion.ubicacion.localidad}} - {{institucion.ubicacion.provincia}}</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Title -->
    <div class="title-section">
      <h1>Acta de Responsabilidad</h1>
    </div>

    <!-- Body -->
    <div class="body-text">
      {{institucion.textosLegales.actaResponsabilidad.introduccionOficina}}
      Yo <strong>{{acta.clienteNombre}}</strong> portador de la C.I. <strong>{{acta.identificacion}}</strong>
      {{institucion.textosLegales.actaResponsabilidad.compromisoUsuario}}
    </div>

    <!-- Clauses -->
    <ol class="clause-list">
      {% for clausula in institucion.textosLegales.actaResponsabilidad.clausulas %}
        <li>
          <span class="clause-num">{{ forloop.index }}.</span>
          {{ clausula }}
        </li>
      {% endfor %}
    </ol>

    <div class="closing-text">
      {{institucion.textosLegales.actaResponsabilidad.cierre}}
    </div>

    <div class="body-text">
      Dado y Firmado a los <strong>{{acta.fechaFirmado}}</strong>.
    </div>

    <!-- Signature -->
    <div class="signature-section">
      <div class="sig-line"></div>
      <div class="sig-label">Firma de Responsabilidad.</div>
      <div class="sig-name">Sr. {{acta.clienteNombre}}</div>
      <div class="sig-ci">C.I. {{acta.identificacion}}</div>
      <div class="sig-role">USUARIO</div>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p>{{institucion.nombreLegal}} &nbsp;|&nbsp; {{institucion.ubicacion.localidad}}, {{institucion.ubicacion.provincia}}, {{institucion.ubicacion.pais}}</p>
    </div>

  </div>
</body>
</html>
