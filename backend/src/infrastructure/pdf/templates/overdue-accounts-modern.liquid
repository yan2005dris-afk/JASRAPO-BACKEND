<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recaudación y Morosidad - Moderno</title>
    {% render "styles" %}
    {% render "modern-styles" %}
    <style>
        .header-right {
            text-align: right;
            border-left: 2px solid var(--brand-light);
            padding-left: 24px;
        }

        .total-label-sm {
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-light);
            font-weight: 700;
            margin: 0 0 4px 0;
        }

        .total-amount-lg {
            font-size: 26px;
            font-weight: 700;
            color: var(--danger, #c0392b);
            margin: 0;
        }

        .metrics-box {
            display: flex;
            justify-content: space-between;
            background-color: var(--brand-light);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            padding: 16px;
            margin-bottom: 24px;
        }

        .metric-col {
            border-left: 1px solid #cbd5e1;
            padding-left: 24px;
        }

        .metric-col:first-child {
            border-left: none;
            padding-left: 0;
        }

        .metric-col-right {
            flex: 1;
            text-align: right;
        }

        .metric-label {
            font-size: 9px;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--brand-accent);
            letter-spacing: 0.5px;
            margin: 0 0 4px 0;
        }

        .metric-value {
            font-size: 13px;
            font-weight: 700;
            color: var(--brand-dark);
            margin: 0;
        }

        .table-container {
            border: 1px solid var(--border-color);
            border-radius: 6px;
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 9px;
        }

        th {
            background-color: var(--brand-main);
            color: #ffffff;
            padding: 10px 12px;
            text-align: left;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        th.text-right { text-align: right; }
        td.text-right { text-align: right; }
        th.text-center { text-align: center; }
        td.text-center { text-align: center; }

        td {
            padding: 9px 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        tr:nth-child(even) td {
            background-color: #f8fafc;
        }

        .col-guia { font-weight: 700; color: var(--brand-dark); }
        .col-cliente { color: #1e293b; font-weight: 500; }
        .col-muted { color: var(--text-light); }
        .col-deuda { font-weight: 700; color: var(--danger, #c0392b); }

        .badge {
            display: inline-block;
            padding: 2px 9px;
            border-radius: 999px;
            font-weight: 700;
            font-size: 8.5px;
        }

        .badge-warn { background: #fef3c7; color: #92660b; }
        .badge-danger { background: #fde2e0; color: #c0392b; }

        .empty-row td {
            text-align: center;
            color: var(--text-light);
            padding: 24px 12px;
        }

        .footer-container {
            margin-top: 30px;
            display: flex;
            justify-content: flex-end;
            page-break-inside: avoid;
        }

        .footer-box {
            background-color: var(--brand-main);
            color: #ffffff;
            border-radius: 6px;
            padding: 16px 32px;
            text-align: right;
            min-width: 260px;
        }

        .footer-label {
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 700;
            color: var(--brand-light);
            letter-spacing: 1px;
            margin: 0 0 6px 0;
            opacity: 0.9;
        }

        .footer-value {
            font-size: 24px;
            font-weight: 700;
            margin: 0;
        }
    </style>
</head>
<body>

<div class="container">

    <header class="header">
        <div class="header-left">
            <div class="logo-container">
                <img src="{{institucion.branding.logo.url}}" alt="Logo institucional">
            </div>
            <div>
                <h1 class="title">{{titulo}}</h1>
                <p class="subtitle">{{institucion.nombreLegal}}</p>
                <p class="date-info">
                    Fecha de corte: <span>{{meta.fechaCorte}}</span>
                    · Versión documental: <span>{{institucion.version}}</span>
                </p>
            </div>
        </div>
        <div class="header-right">
            <p class="total-label-sm">Total Morosidad</p>
            <p class="total-amount-lg">${{kpis.totalMorosidad}}</p>
        </div>
    </header>

    <div class="metrics-box">
        <div class="metric-col">
            <p class="metric-label">Filtro</p>
            <p class="metric-value">{{filtros.descripcion}}</p>
        </div>
        <div class="metric-col">
            <p class="metric-label">Cuentas en mora</p>
            <p class="metric-value">{{kpis.totalMorosos}}</p>
        </div>
        <div class="metric-col metric-col-right">
            <p class="metric-label">Mayor deuda individual</p>
            <p class="metric-value">${{kpis.mayorDeuda}}</p>
        </div>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th style="width: 14%;">N° Guía</th>
                    <th style="width: 26%;">Cliente</th>
                    <th style="width: 13%;">Identificación</th>
                    <th style="width: 16%;">Sector</th>
                    <th class="text-center" style="width: 11%;">Meses Mora</th>
                    <th class="text-center" style="width: 9%;">Últ. Emisión</th>
                    <th class="text-right" style="width: 11%;">Deuda Total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in data %}
                <tr>
                    <td class="col-guia">{{ item.numeroGuia }}</td>
                    <td class="col-cliente">{{ item.clienteNombre }}</td>
                    <td class="col-muted">{{ item.identificacion }}</td>
                    <td>{{ item.sectorNombre }}</td>
                    <td class="text-center">
                        <span class="badge {% if item.severidadCritica %}badge-danger{% else %}badge-warn{% endif %}">
                            {{ item.mesesLabel }}
                        </span>
                    </td>
                    <td class="text-center col-muted">{{ item.ultimaEmision }}</td>
                    <td class="text-right col-deuda">${{ item.saldoPendiente }}</td>
                </tr>
                {% else %}
                <tr class="empty-row">
                    <td colspan="7">No se registraron cuentas en mora para el contexto seleccionado.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="footer-container">
        <div class="footer-box">
            <p class="footer-label">Total General Morosidad</p>
            <p class="footer-value">${{kpis.totalMorosidad}}</p>
        </div>
    </div>

</div>

</body>
</html>
