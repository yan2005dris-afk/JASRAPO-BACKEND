<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; font-size: 11px; color: #333; }
    .container { width: 100%; padding: 20px; }

    .header { border-bottom: 2px solid #0066cc; padding-bottom: 12px; margin-bottom: 16px; }
    .header table { width: 100%; border-collapse: collapse; }
    .header td { border: none; vertical-align: middle; padding: 0; }
    .header td.right { text-align: right; }
    .company-name { font-size: 16px; font-weight: bold; color: #0066cc; }
    .company-sub { font-size: 10px; color: #666; }
    .report-title { font-size: 18px; font-weight: bold; color: #0066cc; }
    .report-meta { font-size: 10px; color: #666; margin-top: 4px; }

    .info-box { background: #f5f8ff; border: 1px solid #c8d8f5; border-radius: 4px; padding: 10px 14px; margin-bottom: 14px; }
    .info-box table { width: 100%; border-collapse: collapse; }
    .info-box td { border: none; padding: 3px 8px; font-size: 10px; }
    .info-box .label { color: #666; font-weight: bold; width: 120px; }

    table.data { width: 100%; border-collapse: collapse; margin-top: 8px; }
    table.data th {
      background-color: #0066cc;
      color: white;
      padding: 7px 8px;
      text-align: center;
      font-size: 10px;
      font-weight: bold;
    }
    table.data td { padding: 6px 8px; border-bottom: 1px solid #e0e0e0; font-size: 10px; text-align: center; vertical-align: middle; }
    table.data tr.even td { background-color: #f5f8ff; }
    table.data tr.total-row td {
      background-color: #0066cc;
      color: white;
      font-weight: bold;
      font-size: 11px;
    }

    .footer { margin-top: 24px; text-align: center; font-size: 9px; color: #aaa; border-top: 1px solid #ddd; padding-top: 8px; }
  </style>
</head>
<body>
  <div class="container">

    <!-- Header -->
    <div class="header">
      <table>
        <tr>
          <td>
            <div class="company-name">JASRAPO</div>
            <div class="company-sub">Junta de Agua Potable y Alcantarillado</div>
            <div class="company-sub">Olón - Santa Elena</div>
          </td>
          <td class="right">
            <div class="report-title">{{reporte.titulo}}</div>
            <div class="report-meta">Fecha de emisión: {{reporte.fechaEmision}}</div>
            <div class="report-meta">Período: {{reporte.rangoFechas}}</div>
          </td>
        </tr>
      </table>
    </div>

    <!-- Info de cuenta -->
    <div class="info-box">
      <table>
        <tr>
          <td class="label">Cuenta:</td>
          <td>{{reporte.cuenta}}</td>
          <td class="label">Cliente:</td>
          <td>{{reporte.clienteNombre}}</td>
        </tr>
        <tr>
          <td class="label">Medidor (serie):</td>
          <td>{{reporte.medidor}}</td>
        </tr>
      </table>
    </div>

    <!-- Tabla de historial -->
    <table class="data">
      <thead>
        <tr>
          <th>#</th>
          <th>EMISIÓN</th>
          <th>L. ACTUAL</th>
          <th>L. ANTERIOR</th>
          <th>CONSUMO</th>
          <th>VAL. EMISIÓN</th>
          <th>ABONOS</th>
          <th>SALDO</th>
        </tr>
      </thead>
      <tbody>
        {{#each reporte.filas}}
        <tr class="{{#if @even}}even{{/if}}">
          <td>{{math @index '+' 1}}</td>
          <td>{{this.emision}}</td>
          <td>{{this.lectActual}}</td>
          <td>{{this.lectAnterior}}</td>
          <td>{{this.consumo}}</td>
          <td>$ {{this.valEmision}}</td>
          <td>$ {{this.abonos}}</td>
          <td>$ {{this.saldo}}</td>
        </tr>
        {{/each}}
        <tr class="total-row">
          <td colspan="5" style="text-align:right; padding-right:12px;">TOTALES:</td>
          <td>$ {{reporte.totalValEmision}}</td>
          <td>$ {{reporte.totalAbonos}}</td>
          <td>$ {{reporte.saldoFinal}}</td>
        </tr>
      </tbody>
    </table>

    <!-- Footer -->
    <div class="footer">
      <p>Reporte generado por el sistema JASRAPO. Documento de uso interno.</p>
    </div>

  </div>
</body>
</html>
