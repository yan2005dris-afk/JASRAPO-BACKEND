<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Listado de Clientes - Moderno</title>
  {{> styles}}
  {{> modern-styles}}
  <style>
    .client-badge {
      display: inline-block;
      padding: 3px 8px;
      font-size: 8px;
      font-weight: 700;
      text-transform: uppercase;
      border-radius: 4px;
      letter-spacing: 0.5px;
    }
    .badge-activo {
      background-color: #dcfce7;
      color: #15803d;
    }
    .badge-inactivo {
      background-color: #fee2e2;
      color: #b91c1c;
    }
    .client-code {
      font-family: monospace;
      font-weight: 700;
      color: var(--brand-dark);
    }
  </style>
</head>
<body>
  <div class="page-container">
    <!-- Modern Header -->
    <div class="header-table">
      <div class="header-left">
        <div class="brand-title">JASRAPO</div>
        <div class="brand-subtitle">Junta de Agua Potable y Alcantarillado · Olón</div>
        <div class="report-title-main" style="margin-top: 8px;">Listado de Clientes</div>
        <div class="report-meta-text">Fecha de emisión: {{reporte.fecha}}</div>
      </div>
      <div class="header-right">
        <div class="total-label-sm">TOTAL CLIENTES</div>
        <div class="total-amount-lg">{{reporte.totalClientes}}</div>
        {{#if reporte.filtrosAplicados}}
        <div class="report-meta-text" style="margin-top: 4px;">Filtros: {{reporte.filtrosAplicados}}</div>
        {{/if}}
      </div>
    </div>

    <!-- Modern Data Table -->
    <table class="modern-table" style="margin-top: 16px;">
      <thead>
        <tr>
          <th style="width: 30px;">#</th>
          <th style="width: 100px;">Identificación</th>
          <th style="width: 80px;">Tipo</th>
          <th>Nombre / Razón Social</th>
          <th>Email</th>
          <th style="width: 90px;">Teléfono</th>
          <th>Dirección</th>
          <th style="width: 70px; text-align: center;">Estado</th>
        </tr>
      </thead>
      <tbody>
        {{#each reporte.clientes}}
        <tr>
          <td style="color: var(--text-light); font-size: 8px;">{{math @index '+' 1}}</td>
          <td class="client-code">{{this.identificacion}}</td>
          <td style="font-size: 8.5px; color: var(--text-muted);">{{this.tipoId}}</td>
          <td style="font-weight: 600; color: var(--brand-dark);">{{this.nombre}}</td>
          <td style="font-size: 8.5px; color: var(--text-muted);">{{this.email}}</td>
          <td style="font-size: 8.5px;">{{this.telefono}}</td>
          <td style="font-size: 8.5px; color: var(--text-muted);">{{this.direccion}}</td>
          <td style="text-align: center;">
            <span class="client-badge {{#if (eq this.activo 'Activo')}}badge-activo{{else}}badge-inactivo{{/if}}">
              {{this.activo}}
            </span>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="footer-note" style="margin-top: 24px;">
      Documento generado automáticamente por JASRAPO Cloud Management System · {{reporte.fecha}}
    </div>
  </div>
</body>
</html>
