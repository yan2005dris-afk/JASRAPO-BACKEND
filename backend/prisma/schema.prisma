  tasa         Float     @map("tasa")
  vigenteDesde DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta")
  descripcion  String?   @map("descripcion")
  activo       Boolean   @default(true) @map("activo")
  createdAt    DateTime  @default(now()) @map("creado_en")
  updatedAt    DateTime  @updatedAt @map("actualizado_en")
  deletedAt    DateTime? @map("borrado_en")

  @@map("parametro_tasa_interes")
}

// --- prisma/schema/models/logica-de-negocio/Rubros.prisma ---
model Rubros {
  rubroId           Int                 @id @default(autoincrement()) @map("rubro_id")
  codigoSri         String?             @unique @map("codigo_sri")
  nombre            String              @default("") @map("nombre")
  descripcion       String              @map("descripcion")
  precioUnitario    Decimal             @map("precio_unitario") @db.Decimal(18, 2)
  tipoRubro         TipoRubro           @map("tipo_rubro")
  impuestoId        Int                 @map("impuesto_id")
  activo            Boolean             @default(true) @map("activo")
  createdAt         DateTime            @default(now()) @map("creado_en")
  updatedAt         DateTime            @updatedAt @map("actualizado_en")
  deletedAt         DateTime?           @map("borrado_en")
  catalogoDescuento CatalogoDescuento[]
  prefacturaDetalle PrefacturaDetalle[]
  impuesto          SriImpuesto         @relation(fields: [impuestoId], references: [id])

  @@index([impuestoId])
  @@map("rubros")
}

enum TipoRubro {
  FIJO
  VARIABLE
  MULTA
  OTRO
  BIEN
  SERVICIO
}

// --- prisma/schema/models/logica-de-negocio/SaldoFavorCliente.prisma ---
model SaldoFavorCliente {
  saldoFavorId          BigInt          @id @default(autoincrement()) @map("saldo_favor_id")
  clienteId             BigInt          @map("cliente_id")
  pagoId                BigInt?         @map("pago_id")
  montoSaldo            Decimal         @map("monto_saldo") @db.Decimal
  tipoOrigen            TipoOrigenAbono @map("tipo_origen")
  disponibleParaAplicar Boolean         @default(true) @map("disponible_para_aplicar")
  createdAt             DateTime        @default(now()) @map("creado_en")
  deletedAt             DateTime?       @map("borrado_en")
  cliente               Clientes        @relation(fields: [clienteId], references: [clienteId])
  pago                  Pagos?          @relation(fields: [pagoId], references: [pagoId])

  @@index([clienteId])
  @@index([pagoId])
  @@index([deletedAt])
  @@map("saldo_favor_cliente")
}

enum TipoOrigenAbono {
  PAGO_EXCESO
  AJUSTE_RECLAMO
  OTROS
}

// --- prisma/schema/models/logica-de-negocio/Sectores.prisma ---
model Sectores {
  sectorId    Int          @id @default(autoincrement()) @map("sector_id")
  comunidadId Int?         @map("comunidad_id")
  codigo      String       @map("codigo")
  nombre      String       @map("nombre")
  createdAt   DateTime     @default(now()) @map("creado_en")
  updatedAt   DateTime     @updatedAt @map("actualizado_en")
  deletedAt   DateTime?    @map("borrado_en")
  contratos   Contratos[]
  comunidades Comunidades? @relation(fields: [comunidadId], references: [comunidadId])

  @@map("sectores")
}
