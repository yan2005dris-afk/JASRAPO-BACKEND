generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// --- prisma/schema/models/autenticacion-autorizacion/MenuPermisos.prisma ---
model MenuPermisos {
  menuPermisoId Int       @id @default(autoincrement()) @map("menu_permiso_id")
  permisoId     Int       @map("permiso_id")
  menuId        Int       @map("menu_id")
  deletedAt     DateTime? @map("borrado_en")
  menu          Menus     @relation(fields: [menuId], references: [menuId])
  permiso       Permisos  @relation(fields: [permisoId], references: [permisoId])

  @@unique([menuId, permisoId])
  @@map("menu_permisos")
}

// --- prisma/schema/models/autenticacion-autorizacion/Menus.prisma ---
model Menus {
  menuId          Int               @id @default(autoincrement()) @map("menu_id")
  menuPadreId     Int?              @map("menu_padre_id")
  icono           String?           @map("icono")
  nombre          String            @map("nombre")
  ruta            String            @map("ruta")
  activo          Boolean           @default(true) @map("activo")
  deletedAt       DateTime?         @map("borrado_en")
  permisosMenu    MenuPermisos[]
  padre           Menus?            @relation("MenuAMenu", fields: [menuPadreId], references: [menuId])
  hijos           Menus[]           @relation("MenuAMenu")

  @@map("menus")
}

// --- prisma/schema/models/autenticacion-autorizacion/Perfiles.prisma ---
model Perfiles {
  perfilId  Int      @id @default(autoincrement()) @map("perfil_id")
  nombres   String?  @map("primer_nombre")
  apellidos String?  @map("apellido")
  telefono  String?  @map("telefono")
  avatar    Json?    @map("avatar")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  usuarioId Int      @unique @map("usuario_id")
  usuario   Usuarios @relation(fields: [usuarioId], references: [usuarioId])

  @@map("perfiles")
}

// --- prisma/schema/models/autenticacion-autorizacion/Permisos.prisma ---
model Permisos {
  permisoId       Int               @id @default(autoincrement()) @map("permiso_id")
  recurso         String            @map("recurso")
  accion          String            @map("accion")
  deletedAt       DateTime?         @map("borrado_en")
  menuPermisos    MenuPermisos[]
  rolPermisos     RolPermisos[]
  usuarioPermisos UsuarioPermisos[]

  @@map("permisos")
}

// --- prisma/schema/models/autenticacion-autorizacion/Roles.prisma ---
model Roles {
  rolId          Int                @id @default(autoincrement()) @map("rol_id")
  nombre         String             @unique @map("nombre")
  deletedAt      DateTime?          @map("borrado_en")
  rolPermisos    RolPermisos[]
  usuarios       Usuarios[]

  @@map("roles")
}

// --- prisma/schema/models/autenticacion-autorizacion/RolPermisos.prisma ---
model RolPermisos {
  rolPermisoId Int         @id @default(autoincrement()) @map("rol_permiso_id")
  rolId        Int         @map("rol_id")
  permisoId    Int         @map("permiso_id")
  deletedAt    DateTime?   @map("borrado_en")
  permiso      Permisos    @relation(fields: [permisoId], references: [permisoId])
  rol          Roles       @relation(fields: [rolId], references: [rolId])

  @@unique([rolId, permisoId])
  @@map("rol_permisos")
}

// --- prisma/schema/models/autenticacion-autorizacion/Sesiones.prisma ---
model Sesiones {
  sesionId         String   @id @default(uuid()) @map("sesion_id")
  usuarioId        Int      @map("usuario_id")
  hashRefreshToken String   @map("hash_token_actualizado")
  direccionIp      String?  @map("direccion_ip")
  usuarioAgente    String?  @map("usuario_agente")
  revocado         Boolean  @default(false) @map("revocado")
  expiraEn         DateTime @map("expira_en")
  createdAt        DateTime @default(now()) @map("creado_en")
  usuario          Usuarios @relation(fields: [usuarioId], references: [usuarioId], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEn])
  @@index([revocado, expiraEn])
  @@map("sesiones")
}

// --- prisma/schema/models/autenticacion-autorizacion/UsuarioPermisos.prisma ---
model UsuarioPermisos {
  usuarioPermisoId Int         @id @default(autoincrement()) @map("id_usuario_permiso")
  usuarioId        Int         @map("usuario_id")
  permisoId        Int         @map("permiso_id")
  permitido        Boolean     @map("permitir")
  deletedAt        DateTime?   @map("borrado_en")
  permiso          Permisos    @relation(fields: [permisoId], references: [permisoId])
  usuario          Usuarios    @relation(fields: [usuarioId], references: [usuarioId])

  @@unique([usuarioId, permisoId])
  @@map("usuario_permisos")
}

// --- prisma/schema/models/autenticacion-autorizacion/Usuarios.prisma ---
model Usuarios {
  usuarioId         Int                @id @default(autoincrement()) @map("usuario_id")
  email             String             @unique @map("email")
  clave             String             @map("contrasenia")
  rolId             Int?               @map("rol_id")
  deletedAt         DateTime?          @map("borrado_en")
  cajaSesion        CajaSesion[]
  descuentosDetalle DescuentoDetalle[] @relation("AutorizadoPor")
  lote              Lote[]
  pagos             Pagos[]
  perfil            Perfiles?
  sesiones          Sesiones[]
  permisosUsuario   UsuarioPermisos[]
  rol               Roles?             @relation(fields: [rolId], references: [rolId])

  @@map("usuarios")
}

// --- prisma/schema/models/facturacion/CatalogoDescuento.prisma ---
model CatalogoDescuento {
  id               Int                @id @default(autoincrement()) @map("catalogo_descuento_id")
  nombre           String             @map("nombre")
  descripcion      String?            @map("descripcion")
  tipoDescuento    TipoDescuento      @map("tipo_descuento")
  valor            Decimal            @map("valor") @db.Decimal(12, 4)
  esPorcentaje     Boolean            @default(true) @map("es_porcentaje")
  rubroId          Int?               @map("rubro_id")
  activo           Boolean            @default(true) @map("activo")
  aplicaAutomatico Boolean            @default(false) @map("aplica_automatico")
  rubro            Rubros?            @relation(fields: [rubroId], references: [rubroId])
  descuentos       DescuentoDetalle[]

  @@map("catalogo_descuento")
}

// --- prisma/schema/models/facturacion/DescuentoDetalle.prisma ---
model DescuentoDetalle {
  descuentoDetalleId  Int               @id @default(autoincrement()) @map("descuento_detalle_id")
  montoDescontado     Decimal           @map("monto_descontado") @db.Decimal(12, 4)
  motivo              String?           @map("motivo")
  autorizadoPor       Int?              @map("autorizado_por")
  fechaCreacion       DateTime          @default(now()) @map("creado_en")
  catalogoDescuentoId Int               @map("catalogo_descuento_id")
  esPorcentaje        Boolean           @default(true) @map("es_porcentaje")
  valorAplicado       Decimal           @default(0) @map("valor_applied") @db.Decimal(12, 4)
  prefacturaDetalleId BigInt            @map("prefactura_detalle_id")
  usuarioAutoriza     Usuarios?         @relation("AutorizadoPor", fields: [autorizadoPor], references: [usuarioId])
  catalogo            CatalogoDescuento @relation(fields: [catalogoDescuentoId], references: [id])
  prefacturaDetalle   PrefacturaDetalle @relation(fields: [prefacturaDetalleId], references: [prefacturaDetalleId], onDelete: Cascade)

  @@index([prefacturaDetalleId])
  @@index([catalogoDescuentoId])
  @@index([autorizadoPor])
  @@map("descuento_detalle")
}

enum TipoDescuento {
  TERCERA_EDAD
  DISCAPACIDAD
  INTERES_MORA
  EXENCION_TASA
  CONVENIO
  OTROS
}

// --- prisma/schema/models/facturacion/Empresa.prisma ---
model Empresa {
  empresaId             Int                @id @default(autoincrement()) @map("empresa_id")
  ruc                   String             @unique @map("ruc")
  razonSocial           String             @map("razon_social")
  nombreComercial       String?            @map("nombre_comercial")
  direccionMatriz       String             @map("direccion_matriz")
  obligadoContabilidad  Boolean            @default(false) @map("obligado_contabilidad")
  contribuyenteEspecial String?            @map("contribuyente_especial")
  agenteRetencion       String?            @map("agente_retencion")
  regimen               String?            @map("regimen")
  logotipoUrl           String?            @map("logotipo_url")
  ambiente              AmbienteSri        @default(PRUEBAS) @map("ambiente")
  tipoEmision           String             @default("1") @map("tipo_emision")
  certificadoP12        String?            @map("certificado_p12")
  passwordCertificado   String?            @map("password_certificado")
  createdAt             DateTime           @default(now()) @map("creado_en")
  updatedAt             DateTime           @updatedAt @map("actualizado_en")
  establecimientos      Establecimientos[]

  @@map("empresa")
}

enum AmbienteSri {
  PRUEBAS
  PRODUCCION
}

// --- prisma/schema/models/facturacion/Establecimientos.prisma ---
model Establecimientos {
  establecimientoId Int             @id @default(autoincrement()) @map("establecimiento_id")
  empresaId         Int             @map("empresa_id")
  codigo            String          @map("codigo") @db.VarChar(3)
  nombre            String          @map("nombre")
  direccion         String          @map("direccion")
  createdAt         DateTime        @default(now()) @map("creado_en")
  updatedAt         DateTime        @updatedAt @map("actualizado_en")
  empresa           Empresa         @relation(fields: [empresaId], references: [empresaId])
  puntosEmision     PuntosEmision[]

  @@unique([empresaId, codigo])
  @@map("establecimientos")
}

// --- prisma/schema/models/facturacion/Facturas.prisma ---
model Facturas {
  facturaId          BigInt             @id @default(autoincrement()) @map("factura_id")
  uuid               String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prefacturaId       BigInt             @unique @map("prefactura_id")
  tipoComprobanteId  Int                @map("tipo_comprobante_id")
  saldoPendiente     Decimal            @default(0) @map("saldo_pendiente") @db.Decimal
  claveAcceso        String?            @unique @map("clave_acceso") @db.VarChar(49)
  secuencial         String             @map("secuencial") @db.VarChar(9)
  numeroAutorizacion String?            @map("numero_autorizacion")
  enviadoSri         Boolean            @default(false) @map("enviado_sri")
  fechaEnvioSri      DateTime?          @map("fecha_enviado_sri")
  pdfUrl             String?            @map("pdf_url")
  respuestaSri       String?            @map("respuesta_sri")
  estadoSri          EstadoSri          @default(BORRADOR) @map("estado_sri")
  estadoPago         EstadoPago         @default(PENDIENTE) @map("estado_pago")
  fechaEmision       DateTime           @default(now()) @map("fecha_emision")
  fechaVencimiento   DateTime           @map("fecha_vencimiento")
  createdBy          String?            @map("creado_por")
  updatedBy          String?            @map("actualizado_por")
  createdAt          DateTime           @default(now()) @map("creado_en")
  updatedAt          DateTime           @updatedAt @map("actualizado_en")
  deletedAt          DateTime?          @map("borrado_en")
  xmlAutorizadoUrl   String?            @map("xml_autorizado_url")
  xmlFirmadoUrl      String?            @map("xml_firmado_url")
  anuladoPor         String?            @map("anulado_por")
  fechaAnulacion     DateTime?          @map("fecha_anulacion")
  motivoAnulacion    String?            @map("motivo_anulacion")
  total              Decimal            @map("total") @db.Decimal
  detallePago        DetallePago[]
  prefactura         Prefacturas        @relation(fields: [prefacturaId], references: [prefacturaId])
  tipoComprobante    SriTipoComprobante @relation(fields: [tipoComprobanteId], references: [id])
  notasCredito       NotasCredito[]
  notasDebito        NotasDebito[]

  @@unique([tipoComprobanteId, secuencial], name: "uk_factura_secuencial")
  @@index([prefacturaId])
  @@index([tipoComprobanteId])
  @@index([secuencial])
  @@index([fechaEmision])
  @@index([estadoPago])
  @@index([estadoSri])
  @@map("facturas")
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  PARCIAL
  VENCIDO
  EN_CONVENIO
  CONVENIO_PAGADO
  ANULADO
}

enum EstadoSri {
  BORRADOR
  FIRMADO
  ENVIADO
  AUTORIZADO
  RECHAZADO
  ERROR
  ANULADA
}

// --- prisma/schema/models/facturacion/Lote.prisma ---
model Lote {
  loteId         BigInt        @id @default(autoincrement()) @map("lote_id")
  comunidadId    Int           @map("comunidad_id")
  periodoId      Int           @map("periodo_id")
  estado         EstadoLote    @default(BORRADOR) @map("estado")
  totalMonto     Decimal       @default(0) @map("total_monto") @db.Decimal(18, 2)
  notas          String?       @map("notas")
  createdAt      DateTime      @default(now()) @map("creado_en")
  updatedAt      DateTime      @updatedAt @map("actualizado_en")
  createdBy      Int?          @map("creado_por")
  totalEmisiones Int           @default(0) @map("total_emisiones")
  comunidad      Comunidades   @relation(fields: [comunidadId], references: [comunidadId])
  usuario        Usuarios?     @relation(fields: [createdBy], references: [usuarioId])
  periodoRel     Periodos      @relation(fields: [periodoId], references: [periodoId])
  prefacturas    Prefacturas[]

  @@unique([comunidadId, periodoId], name: "uk_lote_comunidad_periodo")
  @@index([comunidadId])
  @@index([periodoId])
  @@map("lote")
}

enum EstadoLote {
  BORRADOR
  DEFINITIVO
  ENVIADO
}

// --- prisma/schema/models/facturacion/NotasCredito.prisma ---
model NotasCredito {
  id                 BigInt                @id @default(autoincrement()) @map("id")
  uuid               String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facturaId          BigInt                @map("factura_id")
  puntoEmisionId     Int                   @map("punto_emision_id")
  periodoId          Int                   @map("periodo_id")
  tipoComprobanteId  Int                   @map("tipo_comprobante_id")
  claveAcceso        String?               @unique @map("clave_acceso")
  secuencial         String                @map("secuencial")
  numeroAutorizacion String?               @map("numero_autorizacion")
  fechaEmision       DateTime              @default(now()) @map("fecha_emision")
  motivo             String                @map("motivo")
  subtotal           Decimal               @map("subtotal") @db.Decimal
  iva                Decimal               @map("iva") @db.Decimal
  total              Decimal               @map("total") @db.Decimal
  xmlFirmadoUrl      String?               @map("xml_firmado_url")
  xmlAutorizadoUrl   String?               @map("xml_autorizado_url")
  estadoSri          EstadoSri             @default(BORRADOR) @map("estado_sri")
  createdAt          DateTime              @default(now()) @map("creado_en")
  updatedAt          DateTime              @updatedAt @map("actualizado_en")
  factura            Facturas              @relation(fields: [facturaId], references: [facturaId])
  periodo            Periodos              @relation(fields: [periodoId], references: [periodoId])
  puntoEmision       PuntosEmision         @relation(fields: [puntoEmisionId], references: [puntoEmisionId])
  tipoComprobante    SriTipoComprobante    @relation(fields: [tipoComprobanteId], references: [id])
  detalles           NotasCreditoDetalle[]

  @@index([facturaId])
  @@index([puntoEmisionId])
  @@index([periodoId])
  @@map("notas_credito")
}

model NotasCreditoDetalle {
  id             BigInt       @id @default(autoincrement()) @map("id")
  notaCreditoId  BigInt       @map("nota_credito_id")
  descripcion    String       @map("descripcion")
  cantidad       Decimal      @map("cantidad") @db.Decimal
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal
  descuento      Decimal      @default(0) @map("descuento") @db.Decimal
  subtotal       Decimal      @map("subtotal") @db.Decimal
  iva            Decimal      @map("iva") @db.Decimal
  total          Decimal      @map("total") @db.Decimal
  notaCredito    NotasCredito @relation(fields: [notaCreditoId], references: [id])

  @@map("notas_credito_detalle")
}

// --- prisma/schema/models/facturacion/NotasDebito.prisma ---
model NotasDebito {
  id                  BigInt             @id @default(autoincrement()) @map("id")
  uuid                String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facturaId           BigInt             @map("factura_id")
  puntoEmisionId      Int                @map("punto_emision_id")
  periodoId           Int                @map("periodo_id")
  tipoComprobanteId   Int                @map("tipo_comprobante_id")
  formaPagoId         Int                @map("forma_pago_id")
  claveAcceso         String?            @unique @map("clave_acceso")
  secuencial          String             @map("secuencial")
  numeroAutorizacion  String?            @map("numero_autorizacion")
  fechaEmision        DateTime           @default(now()) @map("fecha_emision")
  subtotal            Decimal            @map("subtotal") @db.Decimal
  iva                 Decimal            @map("iva") @db.Decimal
  total               Decimal            @map("total") @db.Decimal
  xmlFirmadoUrl       String?            @map("xml_firmado_url")
  xmlAutorizadoUrl    String?            @map("xml_autorizado_url")
  estadoSri           EstadoSri          @default(BORRADOR) @map("estado_sri")
  createdAt           DateTime           @default(now()) @map("creado_en")
  updatedAt           DateTime           @updatedAt @map("actualizado_en")
  codigoImpuestoSri   String?            @map("codigo_impuesto_sri")
  codigoPorcentajeSri String?            @map("codigo_porcentaje_sri")
  motivo              String             @map("motivo")
  tarifaImpuesto      Decimal            @default(0) @map("tarifa_impuesto") @db.Decimal
  detallePago         DetallePago[]
  factura             Facturas           @relation(fields: [facturaId], references: [facturaId])
  periodo             Periodos           @relation(fields: [periodoId], references: [periodoId])
  puntoEmision        PuntosEmision      @relation(fields: [puntoEmisionId], references: [puntoEmisionId])
  tipoComprobante     SriTipoComprobante @relation(fields: [tipoComprobanteId], references: [id])

  @@index([facturaId])
  @@index([puntoEmisionId])
  @@index([periodoId])
  @@map("notas_debito")
}

// --- prisma/schema/models/facturacion/Periodos.prisma ---
model Periodos {
  periodoId        Int               @id @default(autoincrement()) @map("periodo_id")
  nombre           String            @unique @map("nombre")
  fechaInicio      DateTime          @map("fecha_inicio")
  fechaFin         DateTime          @map("fecha_fin")
  fechaVencimiento DateTime          @map("fecha_vencimiento")
  estado           EstadoPeriodo     @default(ABIERTO) @map("estado")
  createdAt        DateTime          @default(now()) @map("creado_en")
  updatedAt        DateTime          @updatedAt @map("actualizado_en")
  lecturas         Lecturas[]
  lotes            Lote[]
  notasCredito     NotasCredito[]
  notasDebito      NotasDebito[]
  prefacturas      Prefacturas[]
  retenciones      Retenciones[]

  @@map("periodos")
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
  PROCESANDO
}

// --- prisma/schema/models/facturacion/PrefacturaDetalle.prisma ---
model PrefacturaDetalle {
  prefacturaDetalleId BigInt             @id @default(autoincrement()) @map("prefactura_detalle_id")
  prefacturaId        BigInt             @map("prefactura_id")
  rubroId             Int                @map("rubro_id")
  descripcion         String             @map("descripcion")
  cantidad            Decimal            @map("cantidad") @db.Decimal(18, 2)
  precioUnitario      Decimal            @map("precio_unitario") @db.Decimal(18, 2)
  subtotal            Decimal            @map("subtotal") @db.Decimal(18, 2)
  iva                 Decimal            @map("iva") @db.Decimal(18, 2)
  total               Decimal            @map("total") @db.Decimal(18, 2)
  codigoImpuestoSri   String?            @map("codigo_impuesto_sri")
  createdAt           DateTime           @default(now()) @map("creado_en")
  updatedAt           DateTime           @updatedAt @map("actualizado_en")
  descuento           Decimal            @default(0) @map("descuento") @db.Decimal(18, 2)
  cuotaConvenioId     BigInt?            @map("cuota_convenio_id")
  codigoPorcentajeSri String?            @map("codigo_porcentaje_sri")
  tarifaImpuesto      Decimal            @default(0) @map("tarifa_impuesto") @db.Decimal(18, 2)
  descuentoDetalles   DescuentoDetalle[]
  cuotaConvenio       CuotaConvenio?     @relation(fields: [cuotaConvenioId], references: [cuotaConvenioId])
  prefactura          Prefacturas        @relation(fields: [prefacturaId], references: [prefacturaId], onDelete: Cascade)
  rubro               Rubros             @relation(fields: [rubroId], references: [rubroId])

  @@index([cuotaConvenioId])
  @@map("prefactura_detalle")
}

// --- prisma/schema/models/facturacion/Prefacturas.prisma ---
model Prefacturas {
  prefacturaId          BigInt              @id @default(autoincrement()) @map("prefactura_id")
  uuid                  String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratoId            BigInt              @map("contrato_id")
  loteId                BigInt?             @map("lote_id")
  periodoId             Int                 @map("periodo_id")
  puntoEmisionId        Int                 @map("punto_emision_id")
  lecturaAnterior       Decimal?            @map("lectura_anterior") @db.Decimal(18, 2)
  lecturaActual         Decimal?            @map("lectura_actual") @db.Decimal(18, 2)
  consumoM3             Decimal?            @map("consumo_m3") @db.Decimal(18, 2)
  subtotal              Decimal             @map("subtotal") @db.Decimal(18, 2)
  iva                   Decimal             @map("iva") @db.Decimal(18, 2)
  descuentoTotal        Decimal             @map("descuento_total") @db.Decimal(18, 2)
  totalPagar            Decimal             @map("total_pagar") @db.Decimal(18, 2)
  deudaAnterior         Decimal             @default(0) @map("deuda_anterior") @db.Decimal(18, 2)
  saldoVencido          Decimal             @default(0) @map("saldo_vencido") @db.Decimal(18, 2)
  abono                 Decimal             @default(0) @map("abono") @db.Decimal(18, 2)
  saldoActual           Decimal             @default(0) @map("saldo_actual") @db.Decimal(18, 2)
  meses_atrasado         Int                 @default(0) @map("meses_atrasado")
  estado                EstadoPrefactura    @default(GENERADA) @map("estado")
  aprobadaPor           String?             @map("aprobada_por")
  fechaAprobacion       DateTime?           @map("fecha_aprobacion")
  motivoRechazo         String?             @map("motivo_rechazo")
  createdBy             String?             @map("creado_por")
  updatedBy             String?             @map("actualizado_por")
  createdAt             DateTime            @default(now()) @map("creado_en")
  updatedAt             DateTime            @updatedAt @map("actualizado_en")
  deletedAt             DateTime?           @map("borrado_en")
  interesMora           Decimal             @default(0) @map("interes_mora") @db.Decimal(18, 2)
  clienteDireccion      String?             @map("cliente_direccion")
  clienteEmail          String?             @map("cliente_email")
  clienteIdentificacion String?             @map("cliente_identificacion")
  clienteNombre         String?             @map("cliente_nombre")
  tarifaNombre          String?             @map("tarifa_nombre")
  tarifaValorBase       Decimal?            @map("tarifa_valor_base") @db.Decimal(18, 2)
  tarifaValorExcedente  Decimal?            @map("tarifa_valor_excedente") @db.Decimal(18, 2)
  lecturaId             BigInt?             @map("lectura_id")
