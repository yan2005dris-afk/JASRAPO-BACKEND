  deletedAt        DateTime?            @map("borrado_en")
  latitud          Decimal?             @map("latitud") @db.Decimal(10, 8)
  longitud         Decimal?             @map("longitud") @db.Decimal(11, 8)
  historial        HistorialMedidores[]
  lecturas         Lecturas[]
  contrato         Contratos?           @relation(fields: [contratoId], references: [contratoId], onDelete: Restrict, onUpdate: NoAction)

  @@map("medidores")
}

// --- prisma/schema/models/logica-de-negocio/Pagos.prisma ---
model Pagos {
  pagoId              BigInt               @id @default(autoincrement()) @map("pago_id")
  cajaId              BigInt?              @map("caja_id")
  comprobanteUrlMinIo String?              @map("comprobante_url_minio")
  fechaPago           DateTime             @map("fecha_pago")
  montoTotalRecibido  Decimal              @map("monto_total_recibido") @db.Decimal
  numeroOperacion     String?              @map("numero_operacion")
  observaciones       String?              @map("observaciones")
  referenciaBanco     String?              @map("referencia_banco")
  updatedAt           DateTime             @updatedAt @map("actualizado_en")
  createdAt           DateTime             @default(now()) @map("creado_en")
  deletedAt           DateTime?            @map("borrado_en")
  usuarioId             Int                  @map("usuario_id")
  clienteId           BigInt               @map("cliente_id")
  anuladoPor          String?              @map("anulado_por")
  estadoValidacion    EstadoValidacionPago @default(APROBADO) @map("estado_validacion")
  fechaAnulacion      DateTime?            @map("fecha_anulacion")
  motivoAnulacion     String?              @map("motivo_anulacion")
  detallePago         DetallePago[]
  cajaSesion          CajaSesion?          @relation(fields: [cajaId], references: [cajaId], onDelete: Restrict)
  cliente             Clientes             @relation(fields: [clienteId], references: [clienteId])
  usuario                Usuarios             @relation(fields: [usuarioId], references: [usuarioId])
  saldosFavor         SaldoFavorCliente[]

  @@index([usuarioId])
  @@index([clienteId])
  @@index([cajaId])
  @@map("pagos")
}

enum EstadoValidacionPago {
  REPORTADO
  VALIDANDO
  APROBADO
  RECHAZADO
  CONCILIADO
}

// --- prisma/schema/models/logica-de-negocio/ParametroTasainteres.prisma ---
model ParametroTasainteres {
