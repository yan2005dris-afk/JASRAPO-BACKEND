model User {
  userId       Int       @id @default(autoincrement())
  userName     String
  userEmail    String    @unique
  userPassword String
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  perfilId     Int
  perfil       Perfil @relation(fields: [perfilId], references: [perfilId])
    @@map("User")
  }
