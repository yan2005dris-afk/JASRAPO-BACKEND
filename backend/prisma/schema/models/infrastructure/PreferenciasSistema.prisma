model PreferenciasSistema {
  id          Int      @id @default(autoincrement()) @map("id")
  clave       String   @unique @map("clave")
  valor       String   @map("valor")
  descripcion String?  @map("descripcion")
  categoria   String   @default("GENERAL") @map("categoria")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  updatedBy   String?  @map("actualizado_por")

  @@map("preferencias_sistema")
}
