model Sectores {
  sectorId    Int          @id @default(autoincrement()) @map("sector_id")
  comunidadId Int?         @map("comunidad_id")
  codigo      String       @unique @map("codigo")
  nombre      String       @map("nombre")
  createdAt   DateTime     @default(now()) @map("creado_en")
  updatedAt   DateTime     @updatedAt @map("actualizado_en")
  deletedAt   DateTime?    @map("borrado_en")
  contratos   Contratos[]
  comunidades Comunidades? @relation(fields: [comunidadId], references: [comunidadId])

  @@map("sectores")
}
