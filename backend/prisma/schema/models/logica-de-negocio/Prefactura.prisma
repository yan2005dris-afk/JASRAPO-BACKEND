model Prefactura {
  prefacturaId                  BigInt              @id @default(autoincrement()) @map("prefactura_id")
  contratoId                    BigInt              @map("contrato_id")
  loteId                        BigInt?             @map("lote_id")
  periodo                       String              @map("periodo")
  lecturaAnterior               Decimal?            @map("lectura_anterior") @db.Decimal
  lecturaActual                 Decimal?            @map("lectura_actual") @db.Decimal
  consumoM3                     Decimal?            @map("consumo_m3") @db.Decimal
  montoConsumoAgua              Float               @default(0) @map("monto_consumo_agua")
  montoTasaSeguridad            Float               @default(0) @map("monto_tasa_seguridad")
  montoInteresMora              Float               @default(0) @map("monto_interes_mora")
  montoOtrosCargos              Float               @default(0) @map("monto_otros_cargos")
  montoTotal                    Float               @default(0) @map("monto_total")
  mesesAtrasado                 Int                 @default(0) @map("meses_atrasado")
  deudaAnterior                 Decimal             @default(0) @map("deuda_anterior") @db.Decimal
  saldoVencido                  Decimal             @default(0) @map("saldo_vencido") @db.Decimal
  fechaVencimiento              DateTime?           @map("fecha_vencimiento") @db.Date
  abono                         Decimal             @default(0) @map("abono") @db.Decimal
  saldoActual                   Decimal             @default(0) @map("saldo_actual") @db.Decimal
  estadoPago                    String              @default("PENDIENTE") @map("estado_pago")
  estadoPrefactura              String              @default("BORRADOR") @map("estado_prefactura")
  fechaPrimerRecordatorio       DateTime?           @map("fecha_primer_recordatorio") @db.Timestamp(6)
  fechaUltimoRecordatorio       DateTime?           @map("fecha_ultimo_recordatorio") @db.Timestamp(6)
  cantidadRecordatoriosEnviados Int                 @default(0) @map("cantidad_recordatorios_enviados")
  createdAt                     DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt                     DateTime?           @map("deleted_at") @db.Timestamp(6)
  factura                       Facturas[]
  contrato                      Contratos           @relation(fields: [contratoId], references: [contratoId], onUpdate: NoAction)
  lote                          LoteFacturacion?    @relation(fields: [loteId], references: [loteId], onUpdate: NoAction)
  detalles                      PrefacturaDetalle[]

  @@map("prefactura")
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  PARCIAL
  VENCIDO
  EN_CONVENIO
  CONVENIO_PAGADO
}
