model Facturas {
    facturaId BigInt  @id @default(autoincrement()) @map("factura_id")
    clienteId BigInt? @map("cliente_id")
    lecturaId BigInt? @map("lectura_id")

    fecha       DateTime @map("fecha")
    mes         String   @map("mes")
    consumo     Float?   @map("consumo")
    tarifa      Float?   @map("tarifa")
    interesMora Float?   @map("interes_mora")
    abono       Float?   @map("abono")
    saldo       Float?   @map("saldo")

    cliente        Clientes?        @relation(fields: [clienteId], references: [clienteId])
    lectura        Lecturas?        @relation(fields: [lecturaId], references: [lecturaId])
    detalleFactura DetalleFactura[]
    pagos          Pagos[]

    @@map("facturas")
}
