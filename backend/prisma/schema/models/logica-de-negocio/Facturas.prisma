model Facturas {
  facturaId             BigInt           @id @default(autoincrement()) @map("factura_id")
  claveAccesoSri        String           @map("clave_acceso_sri")
  createdAt             DateTime         @default(now()) @map("created_at")
  deletedAt             DateTime?        @map("deleted_at")
  descuentoTotal        Float            @map("descuento_total")
  enviadoSri            Boolean          @default(false) @map("enviado_sri")
  estado                EstadoFactura    @map("estado")
  fechaEmision          DateTime         @default(now()) @map("fecha_emision")
  fechaEnvioSri         DateTime?        @map("fecha_enviado_sri")
  fechaVencimiento      DateTime         @map("fecha_vencimiento")
  iva                   Float            @map("iva")
  numeroSri             String           @map("numero_sri")
  pdfUrl                String?          @map("pdf_url")
  respuestaSri          String?          @map("respuesta_sri")
  subtotal              Float            @map("subtotal")
  totalPagar            Float            @map("total_pagar")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  xmlSri                String?          @map("xml_sri")
  prefacturaId          BigInt?          @map("prefactura_id")
  clienteId             BigInt?          @map("cliente_id")
  clienteRazonSocial    String?          @map("cliente_razon_social")
  clienteIdentificacion String?          @map("cliente_identificacion")
  clienteDireccion      String?          @map("cliente_direccion")
  clienteEmail          String?          @map("cliente_email")
  formaPagoSri          String?          @default("01") @map("forma_pago_sri")
  detalleFactura        DetalleFactura[]
  detallePago           DetallePago[]
  cliente               Clientes?        @relation(fields: [clienteId], references: [clienteId], onDelete: NoAction, onUpdate: NoAction)
  prefactura            Prefactura?      @relation(fields: [prefacturaId], references: [prefacturaId], onUpdate: NoAction)

  @@map("facturas")
}

enum EstadoFactura {
  BORRADOR
  EMITIDA
  AUTORIZADA
  ANULADA
}
