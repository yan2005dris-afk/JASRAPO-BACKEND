model DetallePago {
  detallePagoId    BigInt          @id @default(autoincrement()) @map("detalle_pago_id")
  pagoId           BigInt          @map("pago_id")
  comprobanteId    BigInt?         @map("comprobante_id")
  cuotaConvenioId  BigInt?         @map("cuota_convenio_id")
  tipoPago         TipoDetallePago @map("tipo_pago")
  montoAbonado     Decimal         @map("monto_abonado") @db.Decimal
  createdAt        DateTime        @default(now()) @map("creado_en")
  deletedAt        DateTime?       @map("borrado_en")
  fechaTransaccion DateTime?       @map("fecha_transaccion")
  formaPagoId      Int             @map("forma_pago_id")
  referencia       String?         @map("referencia")
  
  cuotaConvenio    CuotaConvenio?  @relation(fields: [cuotaConvenioId], references: [cuotaConvenioId])
  comprobante      Comprobantes?   @relation(fields: [comprobanteId], references: [id])
  formaPago        CatalogoFormasPago    @relation(fields: [formaPagoId], references: [id])
  pago             Pagos           @relation(fields: [pagoId], references: [pagoId])

  @@index([pagoId])
  @@index([comprobanteId])
  @@index([cuotaConvenioId])
  @@index([formaPagoId])
  @@map("detalle_pago")
}

enum TipoDetallePago {
  FACTURA
  CUOTA_CONVENIO
  PAGO_LIBRE
  NOTA_DEBITO
  SALDO_FAVOR
}
