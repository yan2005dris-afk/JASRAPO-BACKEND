enum EstadoCuotaConvenio {
  PENDIENTE
  PAGADA
}

model CuotaConvenio {
  cuotaConvenioId       BigInt                @id @default(autoincrement()) @map("cuota_convenio_id")
  convenioId            BigInt                @map("convenio_id")
  numeroCuota           Int                   @map("numero_cuota")
  valorCuota            Decimal               @map("valor_cuota") @db.Decimal(18, 2)
  fechaVencimiento      DateTime              @map("fecha_vencimiento")
  estado                EstadoCuotaConvenio   @default(PENDIENTE) @map("estado")
  fechaPago             DateTime?             @map("fecha_pago")
  montoPagado           Decimal               @default(0) @map("monto_pagado") @db.Decimal(18, 2)
  diasRetraso           Int                   @default(0) @map("dias_retraso")
  interesMoraAplicado   Decimal               @default(0) @map("interes_mora_aplicado") @db.Decimal(18, 2)
  pagoCompleto          Boolean               @default(false) @map("pago_completo")
  fechaPagoAnticipado   DateTime?             @map("fecha_pago_anticipado")
  saldoPendiente        Decimal               @default(0) @map("saldo_pendiente") @db.Decimal(18, 2)
  createdAt             DateTime              @default(now()) @map("creado_en")
  updatedAt             DateTime              @updatedAt @map("actualizado_en")
  deletedAt             DateTime?             @map("borrado_en")

  convenio      Convenios     @relation(fields: [convenioId], references: [convenioId])
  detallePago   DetallePago[]
  prefacturaDetalle PrefacturaDetalle[]

  @@index([convenioId])
  @@map("cuota_convenio")
}
