model Clientes {
  clienteId          BigInt              @id @default(autoincrement()) @map("cliente_id")
  apellidos          String              @map("apellidos")
  direccionDomicilio String?             @map("direccion_domicilio")
  email              String?             @map("email")
  identificacion     String              @unique @map("identificacion")
  nombres            String              @map("nombres")
  razonSocial        String?             @map("razon_social")
  telefono           String?             @map("telefono")
  telefonoSecundario String?             @map("telefono_secundario")
  tipoIdentificacion TipoIdentificacion  @map("tipo_identificacion")
  updatedAt          DateTime            @updatedAt @map("actualizado_en")
  createdAt          DateTime            @default(now()) @map("creado_en")
  deletedAt          DateTime?           @map("borrado_en")
  activo             Boolean             @default(true) @map("activo")
  aplicaDiscapacidad Boolean             @default(false) @map("aplica_discapacidad")
  aplicaTerceraEdad  Boolean             @default(false) @map("aplica_tercera_edad")
  contratos          Contratos[]
  pagos              Pagos[]
  saldosFavor        SaldoFavorCliente[]

  @@index([nombres])
  @@index([deletedAt])
  @@map("clientes")
}

enum TipoIdentificacion {
  CEDULA
  RUC
  PASAPORTE
  CONSUMIDOR_FINAL
  IDENTIFICACION_EXTRANJERA
}
