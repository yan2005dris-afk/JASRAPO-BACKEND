model Rutas {
  rutaId              BigInt             @id @default(autoincrement()) @map("ruta_id")
  nombre              String             @map("nombre")
  descripcion         String?            @map("descripcion")
  operarioId          Int?               @map("operario_id")
  activityTypeId      BigInt             @map("activity_type_id")
  comunidadId         Int                @map("comunidad_id")
  sectorId            Int?               @map("sector_id")
  periodoId           Int?               @map("periodo_id")
  estado              EstadoRuta         @default(PENDIENTE) @map("estado")
  fechaPlanificada    DateTime?          @map("fecha_planificada")
  fechaInicio         DateTime?          @map("fecha_inicio")
  fechaFin            DateTime?          @map("fecha_fin")
  orden               Int                @default(0) @map("orden")
  observacion         String?            @map("observacion")
  fechaLimite         DateTime?          @map("fecha_limite")
  createdAt           DateTime           @default(now()) @map("creado_en")
  updatedAt           DateTime           @updatedAt @map("actualizado_en")
  deletedAt           DateTime?          @map("borrado_en")
  operario            Usuarios?          @relation(fields: [operarioId], references: [usuarioId])
  comunidad           Comunidades        @relation(fields: [comunidadId], references: [comunidadId])
  sector              Sectores?          @relation(fields: [sectorId], references: [sectorId], onDelete: SetNull)
  periodo             Periodos?          @relation(fields: [periodoId], references: [periodoId])
  lotes               Lote[]
  ordenesTrabajo      OrdenesTrabajo[]
  activityType        ActivityType       @relation(fields: [activityTypeId], references: [activityTypeId], onDelete: Restrict)

  @@index([operarioId])
  @@index([comunidadId])
  @@index([sectorId])
  @@index([periodoId])
  @@index([estado])
  @@index([activityTypeId])
  @@index([fechaPlanificada])
  @@index([orden])
  @@map("rutas")
}


enum EstadoRuta {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  PARCIAL
  CANCELADA
}

enum EstadoAsignacion {
  NO_ASIGNADA
  ASIGNADA
  TOMADA
  COMPLETADA
}