model TipoActividad {
  tipoActividadId BigInt   @id @default(autoincrement()) @map("tipo_actividad_id")
  codigo         String   @unique @map("codigo")
  nombre         String   @map("nombre")
  descripcion    String?  @map("descripcion")
  activo         Boolean  @default(true) @map("activo")
  rutas          Rutas[]

  @@index([activo])
  @@map("tipos_actividad")
}
