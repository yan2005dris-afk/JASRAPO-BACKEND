model EstadoMedidor {
  estadoId  BigInt    @id @default(autoincrement()) @map("estado_id")
  codigo    String    @unique @map("codigo")
  nombre    String    @map("nombre")
  activo    Boolean   @default(true) @map("activo")
  orden     Int       @default(0) @map("orden")
  updatedAt DateTime  @updatedAt @map("actualizado_en")
  createdAt DateTime  @default(now()) @map("creado_en")
  deletedAt DateTime? @map("borrado_en")

  medidores Medidores[]

  @@index([codigo])
  @@index([activo])
  @@map("estado_medidor")
}
