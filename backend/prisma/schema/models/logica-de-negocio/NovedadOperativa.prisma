model NovedadOperativa {
  novedadId    BigInt        @id @default(autoincrement()) @map("novedad_id")
  lecturaId    BigInt        @map("lectura_id")
  observacion  String?       @map("observacion")
  tipo         TipoNovedad   @map("tipo")
  estado       EstadoNovedad @map("estado")
  createdAt    DateTime      @default(now()) @map("creado_en")
  updatedAt    DateTime      @updatedAt @map("actualizado_en")
  deletedAt    DateTime?     @map("borrado_en")
  fotoUrlMinIo String?       @map("foto_url_minio")
  lectura      Lecturas      @relation(fields: [lecturaId], references: [lecturaId])

  @@map("novedad_operativa")
}

enum TipoNovedad {
  FUGA
  MEDIDOR_DANADO
  LECTURA_ERRONEA
  OTRO
}

enum EstadoNovedad {
  PENDIENTE
  EN_REVISION
  RESUELTA
  DESCARTADA
}
