model Comunidades {
  comunidadId             Int               @id @default(autoincrement()) @map("comunidad_id")
  nombre                  String            @map("nombre")
  codigo                  String            @unique @map("codigo")
  porcentajeTasaSeguridad Float             @map("porcentaje_tasa_seguridad")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  deletedAt               DateTime?         @map("deleted_at")
  loteFacturacion         LoteFacturacion[]
  sector                  Sectores[]

  @@map("comunidades")
}
