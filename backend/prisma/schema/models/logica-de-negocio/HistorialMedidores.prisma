model HistorialMedidores {
  historialId          BigInt    @id @default(autoincrement()) @map("historial_id")
  medidorId            BigInt    @map("medidor_id")
  contratoId           BigInt    @map("contrato_id")
  fechaDesde           DateTime  @default(now()) @map("fecha_desde")
  fechaHasta           DateTime? @map("fecha_hasta")
  lecturaInicial       Decimal   @map("lectura_inicial_historial") @db.Decimal
  lecturaFinal         Decimal?  @map("lectura_final_historial") @db.Decimal
  motivo               String?   @map("motivo")
  observacion          String?   @map("observacion")
  createdAt            DateTime  @default(now()) @map("creado_en")
  updatedAt            DateTime  @updatedAt @map("actualizado_en")
  deletedAt            DateTime? @map("borrado_en")
  creadoPor            String?   @map("creado_por")
  actualizadoPor        String?   @map("actualizado_por")
  saldoPendienteCambio Decimal?  @default(0) @map("saldo_pendiente_cambio") @db.Decimal
  contrato             Contratos          @relation(fields: [contratoId], references: [contratoId])
  medidor              Medidores          @relation(fields: [medidorId], references: [medidorId])
  reemplazosSaliente   ReemplazoMedidor?  @relation("ReemplazoMedidorSaliente")
  reemplazosEntrante   ReemplazoMedidor?  @relation("ReemplazoMedidorEntrante")
  lecturas             Lecturas[]         @relation("HistorialLecturas")

  @@index([medidorId])
  @@index([contratoId])
  @@map("historial_medidores")
}
