model Contratos {
  contratoId          BigInt               @id @default(autoincrement()) @map("contrato_id")
  clienteId           BigInt               @map("cliente_id")
  sectorId            Int?                 @map("sector_id")
  categoriaTarifaId   Int                  @map("categoria_tarifa_id")
  numeroGuia          String               @unique @map("numero_guia")
  fechaInicio         DateTime             @default(now()) @map("fecha_inicio")
  direccionSuministro String               @map("direccion_suministro")
  latitud             Decimal?             @map("latitud") @db.Decimal(10, 8)
  longitud            Decimal?             @map("longitud") @db.Decimal(11, 8)
  estadoServicio      EstadoServicioContrato @default(PENDIENTE_INSPECCION) @map("estado_servicio")
  estadoCobranza      EstadoCobranzaContrato @default(NO_APLICA) @map("estado_cobranza")
  createdAt           DateTime             @default(now()) @map("creado_en")
  updatedAt           DateTime             @updatedAt @map("actualizado_en")
  deletedAt           DateTime?            @map("borrado_en")
  creadoPor           String?              @map("creado_por")
  tramitadorEsTitular Boolean? @map("tramitador_es_titular")
  tramitadorNombre String? @map("tramitador_nombre") @db.VarChar(200)
  tramitadorIdentificacion String? @map("tramitador_identificacion") @db.VarChar(30)
  relacionTramitador String? @map("relacion_tramitador") @db.VarChar(100)
  observacionesTramite String? @map("observaciones_tramite") @db.VarChar(2000)
  otrasNovedades String? @map("otras_novedades") @db.VarChar(2000)
  registradoPorId Int? @map("registrado_por_id")
  registradoPor Usuarios? @relation("ContratoRegistrador", fields: [registradoPorId], references: [usuarioId], onDelete: Restrict)
  comunidadId         Int                  @map("comunidad_id")
  categoriaTarifa     CategoriaTarifa      @relation(fields: [categoriaTarifaId], references: [categoriaTarifaId])
  cliente             Clientes             @relation(fields: [clienteId], references: [clienteId])
  comunidad           Comunidades          @relation(fields: [comunidadId], references: [comunidadId])
  sector              Sectores?            @relation(fields: [sectorId], references: [sectorId], onDelete: Restrict)
  convenios           Convenios[]
  historialMedidores  HistorialMedidores[]
  prefacturas         Prefacturas[]
  ordenesTrabajo      OrdenesTrabajo[]
  reemplazosMedidor   ReemplazoMedidor[]

  @@index([registradoPorId])
  @@index([clienteId])
  @@index([comunidadId])
  @@index([sectorId])
  @@index([categoriaTarifaId])
  @@map("contratos")
}

enum EstadoServicioContrato {
  PENDIENTE_INSPECCION
  RECHAZADO
  PENDIENTE_PAGO
  PENDIENTE_INSTALACION
  ACTIVO
  SUSPENDIDO
  RETIRADO
}

enum EstadoCobranzaContrato {
  NO_APLICA
  AL_DIA
  EN_MORA
}

enum EstadoDeuda {
  GENERADA
  EN_REVISION
  APROBADA
}
