model PrefacturaDetalle {
  prefacturaDetalleId BigInt     @id @default(autoincrement()) @map("prefactura_detalle_id")
  prefacturaId        BigInt     @map("prefactura_id")
  rubroId             Int?       @map("rubro_id")
  cantidad            Float      @default(1) @map("cantidad")
  precioUnitario      Float      @default(0) @map("precio_unitario")
  descuento           Float      @default(0) @map("descuento")
  subtotal            Float      @default(0) @map("subtotal")
  descripcion         String?    @map("descripcion")
  esAutomatico        Boolean    @default(false) @map("es_automatico")
  createdAt           DateTime   @default(now()) @map("creado_en") @db.Timestamp(6)
  deletedAt           DateTime?  @map("borrado_en") @db.Timestamp(6)
  productoId          BigInt?    @map("producto_id")
  servicioId          BigInt?    @map("servicio_id")
  prefactura          Prefactura @relation(fields: [prefacturaId], references: [prefacturaId], onDelete: Cascade, onUpdate: NoAction)
  producto            Producto?  @relation(fields: [productoId], references: [productoId], onUpdate: NoAction)
  rubro               Rubros?    @relation(fields: [rubroId], references: [rubroId], onUpdate: NoAction)
  servicio            Servicio?  @relation(fields: [servicioId], references: [servicioId], onUpdate: NoAction)

  @@map("prefactura_detalle")
}
