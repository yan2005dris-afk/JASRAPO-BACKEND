model Lecturas {
  lecturaId           BigInt             @id @default(autoincrement()) @map("lectura_id")
  fecha               DateTime           @map("fecha")
  lecturaAnterior     Decimal            @map("lectura_anterior") @db.Decimal
  lecturaActual       Decimal            @map("lectura_actual") @db.Decimal
  consumoCalculado    Decimal            @map("consumo_calculado") @db.Decimal
  deletedAt           DateTime?          @map("borrado_en")
  contratoId          BigInt             @map("contrato_id")
  createdAt           DateTime           @default(now()) @map("creado_en")
  descripcionAnomalia String?            @map("descripcion_anomalia")
  fechaValidacion     DateTime?          @map("fecha_validacion")
  fotoUrlMinIo        String?            @map("foto_url_minio")
  isValidada          Boolean            @default(false) @map("es_validada")
  lecturaInicial      Boolean           @map("lectura_inicial")
  periodoId           Int                @map("periodo_id")
  tieneAnomalia       Boolean            @default(false) @map("tiene_anomalia")
  updatedAt           DateTime           @updatedAt @map("actualizado_en")
  contrato            Contratos           @relation(fields: [contratoId], references: [contratoId])
  periodoRel          PeriodosFacturacion @relation(fields: [periodoId], references: [periodoId])
  novedadesOperativas NovedadOperativa[]

  @@index([contratoId])
  @@index([periodoId])
  @@map("lecturas")
}
