model Lecturas {
  lecturaId           BigInt             @id @default(autoincrement()) @map("lectura_id")
  fecha               DateTime           @map("fecha")
  lecturaAnterior     Decimal            @map("lectura_anterior") @db.Decimal
  lecturaActual       Decimal            @map("lectura_actual") @db.Decimal
  consumoCalculado    Decimal            @map("consumo_calculado") @db.Decimal
  deletedAt           DateTime?          @map("borrado_en")
  createdAt           DateTime           @default(now()) @map("creado_en")
  fechaValidacion     DateTime?          @map("fecha_validacion")
  fotoUrl             String?            @map("foto_url")
  lecturaInicial      Boolean            @default(false) @map("lectura_inicial")
  periodoId           Int                @map("periodo_id")
  descripcionAnomalia String?            @map("descripcion_anomalia")
  updatedAt           DateTime           @updatedAt @map("actualizado_en")

  medidorId           BigInt             @map("medidor_id")
  estado              EstadoLectura      @default(PENDIENTE) @map("estado")
  estadoAsignacion    EstadoAsignacion   @default(NO_ASIGNADA) @map("estado_asignacion")
  rutaId              BigInt?            @map("ruta_id")
  medidor             Medidores          @relation(fields: [medidorId], references: [medidorId], onDelete: Restrict)
  periodoRel          Periodos           @relation(fields: [periodoId], references: [periodoId])
  ruta                Rutas?             @relation(fields: [rutaId], references: [rutaId], onDelete: SetNull)
  lecturaAnomalias LecturaAnomalia[]
  prefacturas         Prefacturas[]

  @@index([periodoId])
  @@index([medidorId])
  @@index([fecha])
  @@index([estado, periodoId])
  @@index([estadoAsignacion])
  @@index([rutaId])
  @@map("lecturas")
  
}

enum EstadoLectura {
  PENDIENTE
  POR_REVISION
  APROBADA
  RECHAZADA_VERIFICACION
  ESTIMADA
  PLANILLADA
  CON_NOVEDAD
}
