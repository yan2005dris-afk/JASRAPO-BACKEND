model Lecturas {
    lecturaId        BigInt  @id @default(autoincrement()) @map("lectura_id")
    contratoId       BigInt @map("contrato_id")

    periodo String  @map("periodo")
    fecha            DateTime @map("fecha")
    lecturaAnterior  Float    @map("lectura_anterior")
    lecturaActual    Float    @map("lectura_actual")
    lecturaInicial   Float    @map("lectura_inicial")
    consumoCalculado Float   @map("consumo_calculado")
    fotoUrlMinIo     String?   @map("foto_url_minio")
    tieneAnomalia    Boolean @default(false) @map("tiene_anomalia") 
    descripcionAnomalia String? @map("descripcion_anomalia")
    isValidada       Boolean @default(false) @map("is_validada") 
    //validadaPor      
    fechaValidacion  DateTime? @map("fecha_validacion")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    contrato Contratos? @relation(fields: [contratoId], references: [contratoId])
    novedadesOperativas NovedadOperativa[]

    @@map("lecturas")
}

