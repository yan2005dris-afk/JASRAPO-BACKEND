enum EstadoMedidor {
  BODEGA
  INSTALADO
  DANADO
  PENDIENTE
  BAJA
}

model Medidores {
  medidorId        BigInt               @id @default(autoincrement()) @map("medidor_id")
  /// Código institucional legado; los medidores nuevos se identifican por su
  /// serie física y dejan este campo sin valor.
  codigo           String?              @unique @map("codigo")
  marca            String               @map("marca")
  modelo           String               @map("modelo")
  serie            String               @unique @map("serie")
  estado           EstadoMedidor        @default(BODEGA) @map("estado")
  fechaInstalacion DateTime?            @default(now()) @map("fecha_instalacion")
  fechaBaja        DateTime?            @map("fecha_baja")
  motivo           String?              @map("motivo")
  createdAt        DateTime             @default(now()) @map("creado_en")
  updatedAt        DateTime             @updatedAt @map("actualizado_en")
  deletedAt        DateTime?            @map("borrado_en")
  historial        HistorialMedidores[]
  lecturas         Lecturas[]
  ordenesTrabajo   OrdenesTrabajo[]

  @@map("medidores")
}
