model CategoriaTarifa {
  categoriaTarifaId  Int         @id @default(autoincrement()) @map("categoria_id")
  nombre             String      @map("nombre")
  descripcion        String?     @map("descripcion")
  valorBase          Decimal?    @default(0) @map("valor_base") @db.Decimal(18, 6)
  consumoMinimoMensual       Int?        @default(0) @map("limite_base_m3")
  valorExcedenteM3   Decimal?    @default(0) @map("valor_excedente_m3") @db.Decimal(18, 6)
  fechaVigenciaDesde DateTime?   @map("fecha_vigencia_desde") @db.Date
  fechaVigenciaHasta DateTime?   @map("fecha_vigencia_hasta") @db.Date
  activo             Boolean     @default(true) @map("activo")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  deletedAt          DateTime?   @map("deleted_at")
  contratos          Contratos[]  
  
  @@map("categoria_tarifa")
}
