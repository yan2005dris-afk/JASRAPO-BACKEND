model DetalleFactura {
  detalleFacturaId BigInt    @id @default(autoincrement()) @map("detalle_factura_id")
  facturaId        BigInt    @map("factura_id")
  cantidad         Float     @map("cantidad")
  precioUnitario   Float     @map("precio_unitario")
  descuento        Float     @default(0) @map("descuento")
  rubroId          Int?      @map("rubro_id")
  subtotal         Float     @map("subtotal")
  productoId       BigInt?   @map("producto_id")
  servicioId       BigInt?   @map("servicio_id")
  descripcion      String?   @map("descripcion")
  porcentajeIva    Float?    @default(0) @map("porcentaje_iva")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")
  factura          Facturas  @relation(fields: [facturaId], references: [facturaId])
  producto         Producto? @relation(fields: [productoId], references: [productoId], onUpdate: NoAction)
  rubro            Rubros?   @relation(fields: [rubroId], references: [rubroId], onDelete: Restrict)
  servicio         Servicio? @relation(fields: [servicioId], references: [servicioId], onUpdate: NoAction)

  @@map("detalle_factura")
}
