model Rubros {
  rubroId           Int                 @id @default(autoincrement()) @map("rubro_id")
  codigoSri         String?             @unique @map("codigo_sri")
  nombre            String              @default("") @map("nombre")
  descripcion       String              @map("descripcion")
  precioUnitario    Decimal             @map("precio_unitario") @db.Decimal(18, 2)
  tipoRubro         TipoRubro           @map("tipo_rubro")
  tarifaImpuestoId  Int                       @map("tarifa_impuesto_id")
  esAutomatico      Boolean                   @default(false) @map("es_automatico")
  activo            Boolean                   @default(true) @map("activo")
  createdAt         DateTime                  @default(now()) @map("creado_en")
  updatedAt         DateTime                  @updatedAt @map("actualizado_en")
  deletedAt         DateTime?                 @map("borrado_en")
  catalogoDescuento CatalogoDescuento[]
  prefacturaDetalle PrefacturaDetalle[]
  tarifaImpuesto    CatalogoTarifasImpuesto   @relation(fields: [tarifaImpuestoId], references: [id])

  @@index([tarifaImpuestoId])
  @@map("rubros")
}

enum TipoRubro {
  FIJO
  VARIABLE
  MULTA
  OTRO
  BIEN
  SERVICIO
}
