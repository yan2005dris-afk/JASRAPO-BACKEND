enum TipoActividadOrden {
  INSTALACION
  LECTURA
  RECONEXION
  INSPECCION
}

enum EstadoOrdenTrabajo {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
  FALLIDA
}

model OrdenesTrabajo {
  ordenTrabajoId       BigInt             @id @default(autoincrement()) @map("orden_trabajo_id")
  rutaId               BigInt             @map("ruta_id")
  contratoId           BigInt             @map("contrato_id")
  medidorId            BigInt?            @map("medidor_id")
  tipoActividad        TipoActividadOrden @default(LECTURA) @map("tipo_actividad")
  estado               EstadoOrdenTrabajo @default(PENDIENTE) @map("estado")
  ordenVisita          Int                @default(0) @map("orden_visita")
  resultadoObservacion String?            @map("resultado_observacion")
  evidenciaFotoUrl     String?            @map("evidencia_foto_url")
  completadoEn         DateTime?          @map("completado_en")
  createdAt            DateTime           @default(now()) @map("creado_en")
  updatedAt            DateTime           @updatedAt @map("actualizado_en")
  deletedAt            DateTime?          @map("borrado_en")

  lecturaId BigInt? @map("lectura_id")

  ruta                  Rutas                    @relation(fields: [rutaId], references: [rutaId], onDelete: Cascade)
  contrato              Contratos                @relation(fields: [contratoId], references: [contratoId], onDelete: Restrict)
  medidor               Medidores?               @relation(fields: [medidorId], references: [medidorId], onDelete: SetNull)
  lectura               Lecturas?                @relation(fields: [lecturaId], references: [lecturaId], onDelete: SetNull)
  reemplazosMedidor     ReemplazoMedidor[]
  ejecucionOrdenTrabajo EjecucionesOrdenTrabajo?
  novedades             NovedadesOrdenTrabajo[]

  @@index([rutaId])
  @@index([contratoId])
  @@index([medidorId])
  @@index([lecturaId])
  @@index([estado])
  @@index([tipoActividad])
  @@map("ordenes_trabajo")
}
