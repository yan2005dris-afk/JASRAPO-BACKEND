model Convenios {
    convenioId BigInt  @id @default(autoincrement()) @map("convenio_id")
    clienteId  BigInt? @map("cliente_id")

    fechaInicio  DateTime  @map("fecha_inicio")
    fechaFin     DateTime? @map("fecha_fin")
    numeroCuotas Int?      @map("numero_cuotas")
    montoCuota   Float?    @map("monto_cuota")
    estado       String?   @map("estado")

    cliente Clientes? @relation(fields: [clienteId], references: [clienteId])

    @@map("convenios")
}
