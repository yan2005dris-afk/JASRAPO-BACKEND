model Convenios {
  convenioId          BigInt              @id @default(autoincrement()) @map("convenio_id")
  numeroCuotas        Int                 @map("numero_cuotas")
  abonoInicial        Decimal             @map("abono_inicial") @db.Decimal(18, 2)
  contratoId          BigInt              @map("contrato_id")
  deudaTotal          Decimal             @map("deuda_total") @db.Decimal(18, 2)
  mesesMoraActual     Int                 @map("meses_mora_actual")
  estadoConvenioId    BigInt              @map("estado_convenio_id")
  fechaAprobacion     DateTime?           @map("fecha_aprobacion")
  fechaPrimerPago     DateTime            @map("fecha_primer_pago")
  fechaProximoPago    DateTime?           @map("fecha_proximo_pago")
  montoPagadoActual   Decimal             @map("monto_pagado_actual") @db.Decimal(18, 2)
  motivo              String?             @map("motivo")
  updatedAt           DateTime            @updatedAt @map("actualizado_en")
  createdAt           DateTime            @default(now()) @map("creado_en")
  deletedAt           DateTime?           @map("borrado_en")

  contrato      Contratos       @relation(fields: [contratoId], references: [contratoId])
  estado        EstadoConvenio  @relation(fields: [estadoConvenioId], references: [estadoConvenioId])
  cuotaConvenio CuotaConvenio[]

  @@index([contratoId])
  @@index([estadoConvenioId])
  @@map("convenios")
}
