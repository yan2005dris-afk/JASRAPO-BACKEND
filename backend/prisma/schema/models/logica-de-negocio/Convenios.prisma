model Convenios {
    convenioId BigInt  @id @default(autoincrement()) @map("convenio_id")
    contratoId BigInt @map("contrato_id")
    deudaTotal Float @map("deuda_total")
    abonoInicial Float @map("abono_inicial")
    numeroCuotas Int @map("numero_cuotas")
    estado       EstadoConvenio @map("estado_convenio")
    fechaPrimerPago  DateTime  @map("fecha_primer_pago")
    fechaProximoPago DateTime? @map("fecha_proximo_pago")
    montoPagadoActual Float @map("monto_pagado_actual")
    diasMoraActual Int @map("dias_mora_actual")
    motivo String? @map("motivo")
    //aprobadoPor
    fechaAprobacion DateTime? @map("fecha_aprobacion")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    deletedAt DateTime? @map("deleted_at")

    cuotaConvenio CuotaConvenio[]
    contrato Contratos? @relation(fields: [contratoId], references: [contratoId])

    @@map("convenios")
}
