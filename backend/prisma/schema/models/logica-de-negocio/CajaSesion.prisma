model CajaSesion {
  cajaId                        BigInt              @id @default(autoincrement()) @map("caja_id")
  creadoPor                     String              @map("creado_por")
  fechaApertura                 DateTime            @default(now()) @map("fecha_apertura")
  montoApertura                 Decimal             @map("monto_apertura") @db.Decimal
  montoCierreSistema            Decimal?            @map("monto_cierre_sistema") @db.Decimal
  montoCierreReal               Decimal?            @map("monto_cierre_real") @db.Decimal
  novedadCierre                 String?             @map("novedad_cierre")
  estado                        EstadoCaja          @map("estado")
  createdAt                     DateTime            @default(now()) @map("creado_en")
  updatedAt                     DateTime            @updatedAt @map("actualizado_en")
  totalChequesDeclarados        Decimal?            @default(0) @map("total_cheques_declarados") @db.Decimal
  totalTransferenciasDeclaradas Decimal?            @default(0) @map("total_transferencias_declaradas") @db.Decimal
  arqueoDetalle                 CajaArqueoDetalle[]
  pagos                         Pagos[]

  @@index([creadoPor])
  @@map("caja_sesion")
}

enum EstadoCaja {
  ABIERTA
  CERRADA
  DESCUADRADA
}
