model LecturaAnomalia {
  anomaliaId            BigInt                    @id @default(autoincrement()) @map("anomalia_id")
  lecturaId             BigInt                    @map("lectura_id")
  observacion           String?                   @map("observacion")
  tipo                  TipoAnomalia              @map("tipo")
  estado                EstadoAnomalia            @map("estado")
  resolucionTipo        ResolucionEconomicaAnomalia? @map("resolucion_tipo")
  consumoAjustado       Decimal?                  @map("consumo_ajustado") @db.Decimal(18, 2)
  observacionResolucion String?                   @map("observacion_resolucion")
  resueltoPorUsuarioId  Int?                      @map("resuelto_por_usuario_id")
  resueltoEn            DateTime?                 @map("resuelto_en")
  createdAt             DateTime                  @default(now()) @map("creado_en")
  updatedAt             DateTime                  @updatedAt @map("actualizado_en")
  deletedAt             DateTime?                 @map("borrado_en")
  fotoUrl               String?                   @map("foto_url")
  lectura               Lecturas                  @relation(fields: [lecturaId], references: [lecturaId])
  resueltoPor           Usuarios?                 @relation("AnomaliaResueltaPor", fields: [resueltoPorUsuarioId], references: [usuarioId])

  @@map("lectura_anomalia")
}

enum TipoAnomalia {
  FUGA
  MEDIDOR_DAÑADO
  LECTURA_ERRONEA
  OTRO
}

enum EstadoAnomalia {
  PENDIENTE
  EN_REVISION
  RESUELTA
  DESCARTADA
}

enum ResolucionEconomicaAnomalia {
  COBRO_REAL
  PROMEDIO_HISTORICO
  EXONERACION_PARCIAL
  EXONERACION_TOTAL
  AJUSTE_LECTURA
}