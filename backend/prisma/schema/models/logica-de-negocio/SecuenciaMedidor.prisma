/// Contador y configuración del código secuencial de los medidores.
/// Es una tabla de una sola fila: `ultimoValor` guarda el último código
/// entregado, de modo que la secuencia vigente queda auditable en la base.
model SecuenciaMedidor {
  secuenciaMedidorId Int      @id @default(autoincrement()) @map("secuencia_medidor_id")
  prefijo            String   @default("MED") @map("prefijo")
  longitud           Int      @default(6) @map("longitud")
  ultimoValor        Int      @default(0) @map("ultimo_valor")
  createdAt          DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @updatedAt @map("actualizado_en")

  @@map("secuencia_medidor")
}
