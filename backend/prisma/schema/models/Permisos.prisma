model Permissions{
    permissionsId              Int         @id @default(autoincrement())     @map("permissions_id")
    
    resource                String                                         
    action                  String
    deletedAt               DateTime?                                      @map("deleted_at")

    rolPermissions          RolPermissions []
    menuPermissions         MenuPermissions []
    userPermissions         UserPermissions []
    @@map("permissions")
}