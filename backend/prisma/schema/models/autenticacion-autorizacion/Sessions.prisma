model Sessions {
  sessionsId       String   @id @default(uuid()) @map("sesion_id")
  usersId          Int      @map("usuario_id")
  refreshTokenHash String   @map("hash_token_actualizado")
  ipAddress        String?  @map("direccion_ip")
  userAgent        String?  @map("usuario_agente")
  isRevoked        Boolean  @default(false) @map("revocado")
  expiresAt        DateTime @map("expira_en")
  createdAt        DateTime @default(now()) @map("creado_en")
  user             Users    @relation(fields: [usersId], references: [usersId], onDelete: Cascade)

  @@index([usersId])
  @@index([expiresAt])
  @@index([isRevoked, expiresAt])
  @@map("sesiones")
}
