model RolPermissions {
  rolPermissionsId Int         @id @default(autoincrement()) @map("rol_permiso_id")
  rolesId          Int         @map("rol_id")
  permissionsId    Int         @map("permiso_id")
  deletedAt        DateTime?   @map("borrado_en")
  permissions      Permissions @relation(fields: [permissionsId], references: [permissionsId])
  roles            Roles       @relation(fields: [rolesId], references: [rolesId])

  @@unique([rolesId, permissionsId])
  @@map("rol_permisos")
}
