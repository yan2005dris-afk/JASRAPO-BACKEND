model MenuPermissions {
  rolMenusId    Int         @id @default(autoincrement()) @map("rol_menus_id")
  permissionsId Int         @map("permissions_id")
  menusId       Int         @map("menu_id")
  deletedAt     DateTime?   @map("deleted_at")
  menus         Menus       @relation(fields: [menusId], references: [menusId])
  permissions   Permissions @relation(fields: [permissionsId], references: [permissionsId])

  @@map("menu_permissions")
}
