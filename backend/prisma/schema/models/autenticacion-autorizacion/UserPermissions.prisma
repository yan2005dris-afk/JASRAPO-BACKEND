model UserPermissions {
  idUserPermissions Int         @id @default(autoincrement()) @map("id_usuario_permiso")
  usersId           Int         @map("usuario_id")
  permissionsId     Int         @map("permiso_id")
  allow             Boolean     @map("permitir")
  deletedAt         DateTime?   @map("borrado_en")
  Permissions       Permissions @relation(fields: [permissionsId], references: [permissionsId])
  users             Users       @relation(fields: [usersId], references: [usersId])

  @@map("usuario_permisos")
}
