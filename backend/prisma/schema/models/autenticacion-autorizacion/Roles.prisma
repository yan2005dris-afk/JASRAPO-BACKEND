model Roles{
    rolesId               Int             @id @default(autoincrement())     @map("roles_id")
    
    name                String             @unique                           @map("name")
    deletedAt           DateTime?                                           @map("deleted_at")


    rolPermissions      RolPermissions []                                   
    users              Users[]                                                                            
    parentRoleLinks    RolesHeredados[]     @relation("RoleParent")
    childRoleLinks     RolesHeredados[]     @relation("RoleChild")

    @@map("roles")
}