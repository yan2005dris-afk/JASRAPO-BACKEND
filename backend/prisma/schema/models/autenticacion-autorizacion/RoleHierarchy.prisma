model RolesHeredados {
  roleHierarchyId Int       @id @default(autoincrement()) @map("rol_heredado_id")
  parentRoleId    Int       @map("rol_padre_id")
  childRoleId     Int       @map("rol_hijo_id")
  deletedAt       DateTime? @map("borrado_en")
  childRole       Roles     @relation("RolHijo", fields: [childRoleId], references: [rolesId])
  parentRole      Roles     @relation("RolPadre", fields: [parentRoleId], references: [rolesId])

  @@unique([parentRoleId, childRoleId])
  @@index([parentRoleId])
  @@index([childRoleId])
  @@map("roles_heredados")
}
