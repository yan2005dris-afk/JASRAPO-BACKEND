model Users {
  usersId   Int       @id @default(autoincrement()) @map("users_id")
  email     String    @unique @map("email")
  password  String    @map("password")
  rolesId   Int?      @map("role_id")
  deletedAt DateTime? @map("deleted_at")

  userPermissions UserPermissions[]
  profile         Profiles?
  role            Roles?             @relation(fields: [rolesId], references: [rolesId])
  sessions        Sessions[]

  pagos Pagos[]
  cajaSesion CajaSesion[]
  cobradorSector CobradorSector[]
  
  @@map("users")
}
