model Menus {
  menusId         Int               @id @default(autoincrement()) @map("menu_id")
  menusParentId   Int?              @map("menu_padre_id")
  icon            String?           @map("icono")
  name            String            @map("nombre")
  route           String            @map("ruta")
  active          Boolean           @default(true) @map("activo")
  deletedAt       DateTime?         @map("borrado_en")
  menuPermissions MenuPermissions[]
  parent          Menus?            @relation("MenuAMenu", fields: [menusParentId], references: [menusId])
  children        Menus[]           @relation("MenuAMenu")

  @@map("menus")
}
