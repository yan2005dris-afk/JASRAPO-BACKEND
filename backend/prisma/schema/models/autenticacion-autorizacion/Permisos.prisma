model Permissions {
  permissionsId   Int               @id @default(autoincrement()) @map("permiso_id")
  resource        String            @map("recurso")
  action          String            @map("accion")
  deletedAt       DateTime?         @map("borrado_en")
  menuPermissions MenuPermissions[]
  rolPermissions  RolPermissions[]
  userPermissions UserPermissions[]

  @@map("permisos")
}
