model Profiles {
  profileId Int      @id @default(autoincrement()) @map("perfil_id")
  firstName String?  @map("primer_nombre")
  lastName  String?  @map("apellido")
  phone     String?  @map("telefono")
  avatar    Json?    @map("avatar")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")
  usersId   Int      @unique @map("usuario_id")
  user      Users    @relation(fields: [usersId], references: [usersId])

  @@map("perfiles")
}
