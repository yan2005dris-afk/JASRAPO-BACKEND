model DescuentoDetalle {
  descuentoDetalleId  Int               @id @default(autoincrement()) @map("descuento_detalle_id")
  montoDescontado     Decimal           @map("monto_descontado") @db.Decimal(12, 4)
  motivo              String?           @map("motivo")
  autorizadoPor       Int?              @map("autorizado_por")
  fechaCreacion       DateTime          @default(now()) @map("creado_en")
  catalogoDescuentoId Int               @map("catalogo_descuento_id")
  esPorcentaje        Boolean           @default(true) @map("es_porcentaje")
  valorAplicado       Decimal           @default(0) @map("valor_applied") @db.Decimal(12, 4)
  prefacturaDetalleId BigInt            @map("prefactura_detalle_id")
  usuarioAutoriza     Usuarios?         @relation("AutorizadoPor", fields: [autorizadoPor], references: [usuarioId])
  catalogo            CatalogoDescuento @relation(fields: [catalogoDescuentoId], references: [id])
  prefacturaDetalle   PrefacturaDetalle @relation(fields: [prefacturaDetalleId], references: [prefacturaDetalleId], onDelete: Cascade)

  @@index([prefacturaDetalleId])
  @@index([catalogoDescuentoId])
  @@index([autorizadoPor])
  @@map("descuento_detalle")
}

enum TipoDescuento {
  TERCERA_EDAD
  DISCAPACIDAD
  INTERES_MORA
  EXENCION_TASA
  CONVENIO
  OTROS
}
