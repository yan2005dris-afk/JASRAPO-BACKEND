model NotasCredito {
  id                 BigInt                @id @default(autoincrement()) @map("id")
  uuid               String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facturaId          BigInt                @map("factura_id")
  puntoEmisionId     Int                   @map("punto_emision_id")
  periodoId          Int                   @map("periodo_id")
  tipoComprobanteId  Int                   @map("tipo_comprobante_id")
  claveAcceso        String?               @unique @map("clave_acceso")
  secuencial         String                @map("secuencial")
  numeroAutorizacion String?               @map("numero_autorizacion")
  fechaEmision       DateTime              @default(now()) @map("fecha_emision")
  motivo             String                @map("motivo")
  subtotal           Decimal               @map("subtotal") @db.Decimal
  iva                Decimal               @map("iva") @db.Decimal
  total              Decimal               @map("total") @db.Decimal
  xmlFirmadoUrl      String?               @map("xml_firmado_url")
  xmlAutorizadoUrl   String?               @map("xml_autorizado_url")
  estadoSri          EstadoSri             @default(BORRADOR) @map("estado_sri")
  createdAt          DateTime              @default(now()) @map("creado_en")
  updatedAt          DateTime              @updatedAt @map("actualizado_en")
  factura            Facturas              @relation(fields: [facturaId], references: [facturaId])
  periodo            Periodos              @relation(fields: [periodoId], references: [periodoId])
  puntoEmision       PuntosEmision         @relation(fields: [puntoEmisionId], references: [puntoEmisionId])
  tipoComprobante    SriTipoComprobante    @relation(fields: [tipoComprobanteId], references: [id])
  detalles           NotasCreditoDetalle[]

  @@index([facturaId])
  @@index([puntoEmisionId])
  @@index([periodoId])
  @@map("notas_credito")
}

model NotasCreditoDetalle {
  id             BigInt       @id @default(autoincrement()) @map("id")
  notaCreditoId  BigInt       @map("nota_credito_id")
  descripcion    String       @map("descripcion")
  cantidad       Decimal      @map("cantidad") @db.Decimal
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal
  descuento      Decimal      @default(0) @map("descuento") @db.Decimal
  subtotal       Decimal      @map("subtotal") @db.Decimal
  iva            Decimal      @map("iva") @db.Decimal
  total          Decimal      @map("total") @db.Decimal
  notaCredito    NotasCredito @relation(fields: [notaCreditoId], references: [id])

  @@map("notas_credito_detalle")
}
