model SriImpuesto {
  id               Int      @id @default(autoincrement()) @map("id")
  codigo           String   @map("codigo")
  codigoPorcentaje String   @map("codigo_porcentaje")
  nombre           String   @map("nombre")
  tarifa           Decimal  @map("tarifa") @db.Decimal
  activo           Boolean  @default(true) @map("activo")
  createdAt        DateTime @default(now()) @map("creado_en")
  updatedAt        DateTime @updatedAt @map("actualizado_en")
  rubros           Rubros[]

  @@unique([codigo, codigoPorcentaje])
  @@map("sri_impuesto")
}
