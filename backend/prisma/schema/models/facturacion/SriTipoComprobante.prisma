model SriTipoComprobante {
  id               Int        @id @default(autoincrement()) @map("id")
  codigo           String     @unique @map("codigo") // Ej: "01", "04", "05", "07"
  nombre           String     @map("nombre") // Ej: "Factura", "Nota de Crédito"
  descripcion      String?    @map("descripcion")
  activo           Boolean    @default(true) @map("activo")
  
  // Relaciones
  facturas         Facturas[]
  notasCredito     NotasCredito[]
  notasDebito      NotasDebito[]
  retenciones      Retenciones[]

  @@map("sri_tipo_comprobante")
}
