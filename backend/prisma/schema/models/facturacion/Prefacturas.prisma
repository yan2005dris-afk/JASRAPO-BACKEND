model Prefacturas {
  prefacturaId          BigInt              @id @default(autoincrement()) @map("prefactura_id")
  uuid                  String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contratoId            BigInt              @map("contrato_id")
  loteId                BigInt?             @map("lote_id")
  periodoId             Int                 @map("periodo_id")
  puntoEmisionId        Int                 @map("punto_emision_id")
  lecturaAnterior       Decimal?            @map("lectura_anterior") @db.Decimal
  lecturaActual         Decimal?            @map("lectura_actual") @db.Decimal
  consumoM3             Decimal?            @map("consumo_m3") @db.Decimal
  subtotal              Decimal             @map("subtotal") @db.Decimal
  iva                   Decimal             @map("iva") @db.Decimal
  descuentoTotal        Decimal             @map("descuento_total") @db.Decimal
  totalPagar            Decimal             @map("total_pagar") @db.Decimal
  deudaAnterior         Decimal             @default(0) @map("deuda_anterior") @db.Decimal
  saldoVencido          Decimal             @default(0) @map("saldo_vencido") @db.Decimal
  abono                 Decimal             @default(0) @map("abono") @db.Decimal
  saldoActual           Decimal             @default(0) @map("saldo_actual") @db.Decimal
  mesesAtrasado         Int                 @default(0) @map("meses_atrasado")
  estado                EstadoPrefactura    @default(GENERADA) @map("estado")
  aprobadaPor           String?             @map("aprobada_por")
  fechaAprobacion       DateTime?           @map("fecha_aprobacion")
  motivoRechazo         String?             @map("motivo_rechazo")
  createdBy             String?             @map("creado_por")
  updatedBy             String?             @map("actualizado_por")
  createdAt             DateTime            @default(now()) @map("creado_en")
  updatedAt             DateTime            @updatedAt @map("actualizado_en")
  deletedAt             DateTime?           @map("borrado_en")
  interesMora           Decimal             @default(0) @map("interes_mora") @db.Decimal
  clienteDireccion      String?             @map("cliente_direccion")
  clienteEmail          String?             @map("cliente_email")
  clienteIdentificacion String?             @map("cliente_identificacion")
  clienteNombre         String?             @map("cliente_nombre")
  tarifaNombre          String?             @map("tarifa_nombre")
  tarifaValorBase       Decimal?            @map("tarifa_valor_base") @db.Decimal
  tarifaValorExcedente  Decimal?            @map("tarifa_valor_excedente") @db.Decimal
  lecturaId             BigInt?             @map("lectura_id")
  tasaInteresUsada      Decimal             @default(0) @map("tasa_interes_usada") @db.Decimal
  factura               Facturas?
  prefacturaDetalle     PrefacturaDetalle[]
  contrato              Contratos           @relation(fields: [contratoId], references: [contratoId], onUpdate: NoAction)
  lectura               Lecturas?           @relation(fields: [lecturaId], references: [lecturaId], onUpdate: NoAction)
  lote                  LoteFacturacion?    @relation(fields: [loteId], references: [loteId], onUpdate: NoAction)
  periodoRel            Periodos            @relation(fields: [periodoId], references: [periodoId], onUpdate: NoAction)
  puntoEmision          PuntosEmision       @relation(fields: [puntoEmisionId], references: [puntoEmisionId], onUpdate: NoAction)

  @@unique([contratoId, periodoId])
  @@index([periodoId])
  @@index([contratoId])
  @@index([puntoEmisionId])
  @@map("prefacturas")
}

enum EstadoPrefactura {
  GENERADA
  EN_REVISION
  APROBADA
  RECHAZADA
  ANULADA
  PAGADA
}
