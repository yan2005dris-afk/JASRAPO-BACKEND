model Periodos {
  periodoId        Int               @id @default(autoincrement()) @map("periodo_id")
  nombre           String            @unique @map("nombre")
  fechaInicio      DateTime          @map("fecha_inicio")
  fechaFin         DateTime          @map("fecha_fin")
  fechaVencimiento DateTime          @map("fecha_vencimiento")
  estado           EstadoPeriodo     @default(ABIERTO) @map("estado")
  createdAt        DateTime          @default(now()) @map("creado_en")
  updatedAt        DateTime          @updatedAt @map("actualizado_en")
  deletedAt        DateTime?         @map("borrado_en")
  creadoPor        String?           @map("creado_por")
  actualizadoPor   String?           @map("actualizado_por")
  lecturas         Lecturas[]
  lotes              Lote[]
  prefacturas        Prefacturas[]
  rutas              Rutas[]
  reemplazosOrigen   ReemplazoMedidor[] @relation("ReemplazoPeriodoOrigen")
  reemplazosDestino  ReemplazoMedidor[] @relation("ReemplazoPeriodoDestino")

  @@map("periodos")
}

enum EstadoPeriodo {
  ABIERTO
  CERRADO
  PROCESANDO
}
