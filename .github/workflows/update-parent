name: Actualizar Repo Unificado

on:
  push:
    branches:
      - develop

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout JASRAPO en carpeta separada
        uses: actions/checkout@v4
        with:
          repository: Brydyan/JASRAPO
          token: ${{ secrets.PERSONAL_TOKEN }}
          path: jasrapo
          submodules: true
          fetch-depth: 0

      - name: Actualizar submódulo backend
        run: |
          cd jasrapo

          git submodule update --remote backend

          git config user.name "github-actions"
          git config user.email "actions@github.com"

          git add backend

          if [[ -n $(git status -s) ]]; then
            git commit -m "Auto-update backend desde develop"
            git push origin develop
          else
            echo "No hay cambios en el submódulo."
          fi
