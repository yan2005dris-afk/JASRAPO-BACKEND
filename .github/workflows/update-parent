name: Actualizar Repo Unificado

on:
  push:
    branches:
      - develop

jobs:
  update:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout del Repo Padre (JASRAPO)
        uses: actions/checkout@v4
        with:
          repository: Brydyan/JASRAPO
          token: ${{ secrets.PERSONAL_TOKEN }}
          submodules: true
          fetch-depth: 0

      - name: Actualizar submódulo backend
        run: |
          cd backend
          git fetch origin develop
          git checkout develop
          git pull origin develop
          cd ..

          git config user.name "github-actions"
          git config user.email "actions@github.com"

          git add backend

          if [[ -n $(git status -s) ]]; then
            git commit -m "Auto-update: backend actualizado desde develop"
            git push origin develop
          else
            echo "No hay cambios en el submódulo."
          fi
