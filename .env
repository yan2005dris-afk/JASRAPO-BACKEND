# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5433

# JWT ACCESS
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=15m

# JWT REFRESH
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── Backend ───────────────────────────────────
# Para desarrollo local (prisma db push, etc.) usa localhost:5433
DATABASE_URL=postgresql://appuser:apppass@localhost:5433/appdb
# Para Docker (cuando backend corra en contenedor) usar:
# DATABASE_URL=postgresql://appuser:apppass@postgres:5432/appdb
BACKEND_PORT=3000

# ─── Frontend ──────────────────────────────────
FRONTEND_PORT=4200
