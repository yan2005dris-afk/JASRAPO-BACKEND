# ─── PostgreSQL ─────────────────────────────────
POSTGRES_USER=appuser
POSTGRES_DB=appdb
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# ─── JWT ACCESS ────────────────────────────────
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=1m
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,https://app.dihm-muertos.site

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ─── MinIO (Almacenamiento de archivos) ───────
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123

# ─── Observabilidad ────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=jasrapo-backend
OTEL_TRACE_SAMPLE_RATIO=0.1
LOKI_URL=http://localhost:3101
