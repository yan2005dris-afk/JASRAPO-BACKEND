# ═══════════════════════════════════════════════════════════════════
# Configuración de Infraestructura — JASRAPO Backend
# ═══════════════════════════════════════════════════════════════════
# Este archivo lo usa Docker Compose para levantar el stack
# completo (PostgreSQL, RustFS, Backend, Observabilidad).
#
# También es cargado como env_file por el contenedor del backend
# en producción, por lo que debe contener TODAS las variables que
# la app NestJS necesita en ese entorno.
#
# Copia este archivo como .env y ajusta los valores.
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL — Base de datos principal
# ═══════════════════════════════════════════════════════════════════
# Estas variables configuran el contenedor de PostgreSQL y también
# se usan para armar la DATABASE_URL del backend en docker-compose.

# Nombre de la base de datos
POSTGRES_DB=appdb
# Usuario de la base de datos
POSTGRES_USER=appuser
# Contraseña del usuario
POSTGRES_PASSWORD=apppass
# Puerto de PostgreSQL (dentro del contenedor Docker)
POSTGRES_PORT=5432
# Usar SSL para la conexión a PostgreSQL
POSTGRES_SSL=false

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL — Pool de conexiones (Prisma)
# ═══════════════════════════════════════════════════════════════════
# Configuración del pool de conexiones de Prisma. Afecta cómo se
# manejan las conexiones concurrentes a la base de datos.

# Máximo de conexiones en el pool
DB_POOL_MAX=10
# Tiempo máximo de inactividad antes de cerrar una conexión (ms)
DB_POOL_IDLE_TIMEOUT=30000
# Tiempo máximo de espera para establecer una conexión (ms)
DB_CONNECTION_TIMEOUT=10000

# ═══════════════════════════════════════════════════════════════════
# JWT — Autenticación y tokens
# ═══════════════════════════════════════════════════════════════════

# Secreto para firmar tokens de acceso (¡cambiá en producción!)
JWT_ACCESS_SECRET=access_super_secret_key
# Duración del token de acceso (ej: 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m
# Secreto para firmar tokens de refresh (¡cambiá en producción!)
JWT_REFRESH_SECRET=refresh_super_secret_key
# Duración del token de refresh (formato ms: 24h, 7d, 30d).
# Por seguridad el default es 24h. Valores > 72h requieren
# ALLOW_LONG_REFRESH=1 o el proceso falla al arrancar.
JWT_REFRESH_EXPIRES_IN=24h
# Opt-in para permitir JWT_REFRESH_EXPIRES_IN > 72h. Úsese solo
# en entornos donde el riesgo de cookie leakage de larga duración
# esté mitigado por otros controles (rotación de cookies, mTLS, etc.).
# ALLOW_LONG_REFRESH=0

# ═══════════════════════════════════════════════════════════════════
# CORS — Orígenes permitidos
# ═══════════════════════════════════════════════════════════════════

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# ═══════════════════════════════════════════════════════════════════
# Entorno y Servidor — Configuración general de la app
# ═══════════════════════════════════════════════════════════════════

# Entorno de ejecución: development | production | test
NODE_ENV=development
# Puerto interno del backend (dentro del contenedor)
PORT=3000
# Puerto externo del backend (mapeo del contenedor)
BACKEND_PORT=3002
# Puerto del frontend (para referencia/compatibilidad)
FRONTEND_PORT=8081
# URL de conexión para Prisma y PgBoss
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ═══════════════════════════════════════════════════════════════════
# S3-compatible Storage — Almacenamiento de objetos
# ═══════════════════════════════════════════════════════════════════
# Conexión al servidor S3-compatible (RustFS, MinIO, etc.)

# Host del servidor S3
STORAGE_ENDPOINT=localhost
# Puerto del servidor S3
STORAGE_PORT=9000
# Usar SSL para la conexión
STORAGE_USE_SSL=false
# Access key para autenticación S3
STORAGE_ACCESS_KEY=rustfsadmin
# Secret key para autenticación S3
STORAGE_SECRET_KEY=rustfsadmin
# Prefijo para los buckets SRI (usado para multi-tenant por RUC)
STORAGE_BUCKET_PREFIX=sri
# Tiempo de expiración de URLs prefirmadas en horas (default: 24)
STORAGE_URL_EXPIRY_HOURS=24

# ═══════════════════════════════════════════════════════════════════
# Observabilidad — Logging, Trazas y Métricas
# ═══════════════════════════════════════════════════════════════════

# Nivel de logs: trace | debug | info | warn | error
LOG_LEVEL=info
# Pretty-print para desarrollo local
LOG_PRETTY=true
# Endpoint de Loki para envío de logs
LOKI_URL=http://localhost:3101
# Habilitar métricas de OpenTelemetry
OTEL_METRICS_ENABLED=true
# Endpoint OTLP HTTP (Tempo / collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Nombre del servicio reportado en trazas
OTEL_SERVICE_NAME=jasrapo-backend
# Ratio de muestreo de trazas en producción (0.0 a 1.0)
OTEL_TRACE_SAMPLE_RATIO=0.1
# Puerto de Grafana (para referencia en docker-compose)
GRAFANA_PORT=3003

# ═══════════════════════════════════════════════════════════════════
# SRI — Integración con el Servicio de Rentas Internas
# ═══════════════════════════════════════════════════════════════════
# Configuración para facturación electrónica ecuatoriana.

# URL base pública del backend
PUBLIC_URL=http://localhost:3000
# Emisión asíncrona de comprobantes (true/false)
SRI_EMISION_ASYNC=true
# Máximo de reintentos para envíos al SRI
SRI_MAX_RETRIES=3
# Tiempo de espera entre reintentos al SRI (ms)
SRI_RETRY_DELAY_MS=2000
# Límite máximo de comprobantes a emitir en modo síncrono
SRI_SYNC_MAX_LIMIT=500
# Ambiente SRI: 1 = Pruebas, 2 = Producción
SRI_AMBIENTE=1

# ═══════════════════════════════════════════════════════════════════
# SRI — Encriptación
# ═══════════════════════════════════════════════════════════════════

# Clave para encriptar datos sensibles (32 caracteres)
ENCRYPTION_KEY=cambiame_por_una_llave_segura_de_32_chars
# Salt para derivación de clave de encriptación
ENCRYPTION_SALT=cambiame_por_un_salt_de_32_chars

# ═══════════════════════════════════════════════════════════════════
# SRI — Directorios de Almacenamiento Local (Fallback)
# ═══════════════════════════════════════════════════════════════════

# Directorio para archivos XML
XMLS_DIR=../xmls
# Directorio para certificados digitales (.p12)
CERTS_DIR=../certs

# ═══════════════════════════════════════════════════════════════════
XADES_HASH_ALGO=SHA-256

# SRI — Cache de Certificados
# ═══════════════════════════════════════════════════════════════════

# TTL del cache de certificados digitales (ms, default: 1 hora)
CACHE_CERT_TTL_MS=3600000

# ═══════════════════════════════════════════════════════════════════
# SRI — Firma Visual en PDF
# ═══════════════════════════════════════════════════════════════════

# Tamaño del código QR en la firma (píxeles)
SIGNATURE_QR_SIZE=50
# Ancho total del recuadro de firma (píxeles)
SIGNATURE_TOTAL_WIDTH=200
# Posición X por defecto de la firma
SIGNATURE_DEFAULT_X=0
# Posición Y por defecto de la firma
SIGNATURE_DEFAULT_Y=0
# Página por defecto para la firma (-1 = última página)
SIGNATURE_DEFAULT_PAGE=-1

# ═══════════════════════════════════════════════════════════════════
# Correo Electrónico — Estrategia y Proveedores
# ═══════════════════════════════════════════════════════════════════

# Estrategia de selección de proveedor: failover | round-robin
MAIL_PROVIDER_STRATEGY=failover

# ─── Proveedor primario: Brevo (Sendinblue) ────────────────────────

# Host SMTP de Brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
# Puerto SMTP de Brevo
BREVO_SMTP_PORT=587
# Usuario SMTP de Brevo (API key)
BREVO_SMTP_USER=1@smtp-brevo.com
# Contraseña SMTP de Brevo (API key)
BREVO_SMTP_PASS=tu-api-key-brevo

# ─── Proveedor secundario: Gmail / Hostinger ───────────────────────

# Servicio SMTP
EMAIL_SERVICE=gmail
# Host SMTP de respaldo
EMAIL_HOST=smtp.gmail.com
# Puerto SMTP de respaldo
EMAIL_PORT=587
# Usar SSL en SMTP de respaldo
EMAIL_SECURE=false
# Usuario SMTP de respaldo
EMAIL_USER=your-email@gmail.com
# Contraseña SMTP de respaldo
EMAIL_PASSWORD=your-password

# ─── Configuración común de correo ─────────────────────────────────

# Dirección de correo remitente por defecto
EMAIL_FROM=no-reply@jasrapo.com
# Nombre del remitente por defecto
EMAIL_FROM_NAME="JASRAP-Olon"

# ═══════════════════════════════════════════════════════════════════
# Puppeteer — Generación local de PDFs
# ═══════════════════════════════════════════════════════════════════
# Ruta al ejecutable de Chrome/Chromium para Puppeteer.
# Se usa para generar PDFs localmente.
# Según el sistema operativo:
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
#   Mac:     /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   /usr/bin/google-chrome

PUPPETEER_EXECUTABLE_PATH=
