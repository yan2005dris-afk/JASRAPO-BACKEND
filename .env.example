# ─── PostgreSQL ─────────────────────────────────
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432
POSTGRES_SSL=false
# Pool de conexiones
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# ─── JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=access_super_secret_key
JWT_ACCESS_EXPIRES_IN=1m
JWT_REFRESH_SECRET=refresh_super_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────
# Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# ─── Backend / Entorno ─────────────────────────
NODE_ENV=development
PORT=3000
# DATABASE_URL para uso local (Prisma fuera de Docker)
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb

# ─── S3-compatible Storage (RustFS) ────────────
# Endpoint del servidor S3 (RustFS o similar)
STORAGE_ENDPOINT=localhost
# Puerto del servidor S3
STORAGE_PORT=9000
# Usar SSL (https)
STORAGE_USE_SSL=false
# Credenciales
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
# Bucket prefix para nombres dinámicos (sri-{ruc}-{type})
STORAGE_BUCKET_PREFIX=sri-
# URL expiration in hours (default: 24)
STORAGE_URL_EXPIRY_HOURS=24

# ─── Observabilidad ────────────────────────────
# Nivel de logs: trace, debug, info, warn, error
LOG_LEVEL=info
# Pretty logs para desarrollo local
LOG_PRETTY=true
# Habilita OpenTelemetry/tracing
OTEL_METRICS_ENABLED=true
# Endpoint OTLP HTTP (Tempo / collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Nombre del servicio reportado en trazas
OTEL_SERVICE_NAME=jasrapo-backend
# Ratio de muestreo en producción
OTEL_TRACE_SAMPLE_RATIO=0.1
# Loki HTTP push API
LOKI_URL=http://localhost:3101

# ─── SRI Integration ───────────────────────────
# URL base pública para generar enlaces a archivos
PUBLIC_URL=http://localhost:3000
# Emisión asíncrona de comprobantes (true/false)
SRI_EMISION_ASYNC=true
# Reintentos y timeouts SRI
SRI_MAX_RETRIES=3
SRI_RETRY_DELAY_MS=2000
SRI_SYNC_MAX_LIMIT=500
# Ambiente SRI (1=pruebas, 2=producción)
SRI_AMBIENTE=1
# Encriptación
ENCRYPTION_KEY=cambiame_por_una_llave_segura_de_32_chars
ENCRYPTION_SALT=cambiame_por_un_salt_de_32_chars
# Directorios
XMLS_DIR=../xmls
CERTS_DIR=../certs
# Configuración de firma visual PDF
SIGNATURE_QR_SIZE=50
SIGNATURE_TOTAL_WIDTH=200
SIGNATURE_DEFAULT_X=0
SIGNATURE_DEFAULT_Y=0
SIGNATURE_DEFAULT_PAGE=-1
# Cache de certificados (ms)
CACHE_CERT_TTL_MS=3600000
# Carbone API (generación de PDFs)
CARBONE_API=http://localhost:5000
CARBONE_RENDER_OPTIONS={}
PDF_MAX_ATTEMPTS=2
PDF_RETRY_DELAY=10

# ─── Mail Provider Strategy ─────────────────────
MAIL_PROVIDER_STRATEGY=primary-fallback

# ─── Primary: Brevo (Sendinblue) ────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=1@smtp-brevo.com
BREVO_SMTP_PASS=tu-api-key-brevo

# ─── Fallback: Gmail/Hostinger ──────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-password

# ─── Común ─────────────────────────────────────
EMAIL_FROM=no-reply@jasrapo.com
EMAIL_FROM_NAME="JASRAP-Olon"
